@* Admin Dashboard sub-component *@

@if (Data is not null)
{
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.TotalUsers</div>
                <div class="text-muted small mt-1">Estudiantes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.ActiveGroups</div>
                <div class="text-muted small mt-1">Grupos Activos</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-gold);font-family:'Montserrat',sans-serif;">@Data.PendingGroupRequests</div>
                <div class="text-muted small mt-1">Solicitudes Pendientes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.TotalEvents</div>
                <div class="text-muted small mt-1">Eventos Creados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.TotalMemberships</div>
                <div class="text-muted small mt-1">Membresías</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.TotalParticipations</div>
                <div class="text-muted small mt-1">Participaciones</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-uerre p-4 text-center">
                <div class="fw-bold" style="font-size:2rem;color:var(--uerre-purple);font-family:'Montserrat',sans-serif;">@Data.TotalGroups</div>
                <div class="text-muted small mt-1">Total Grupos</div>
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-3">
    <a href="/admin/users" class="btn btn-uerre-outline">&#9651; Gestionar Usuarios</a>
    <a href="/admin/groups" class="btn btn-uerre-outline">Gestionar Grupos</a>
    <a href="/admin/requests" class="btn btn-uerre-outline">Solicitudes Pendientes</a>
</div>

@code {
    [Parameter] public DashboardAdminModel? Data { get; set; }
}
