@* Leader Dashboard sub-component *@
@inject GroupApiService GroupService

<!-- Pending membership requests with inline approve/reject -->
@if (Data?.PendingMembershipRequests?.Count > 0)
{
    <h5 class="fw-bold mb-3">
        Solicitudes Pendientes
        <span class="badge rounded-pill ms-1 text-white" style="background:var(--uerre-purple);font-size:.7rem;">
            @Data.PendingMembershipRequests.Count
        </span>
    </h5>
    <div class="d-flex flex-column gap-2 mb-5">
        @foreach (var req in Data.PendingMembershipRequests)
        {
            <div class="card-uerre p-3 d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(req.AvatarUrl))
                {
                    <img src="@req.AvatarUrl" alt=""
                         class="rounded-circle flex-shrink-0"
                         style="width:36px;height:36px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:36px;height:36px;background:var(--uerre-purple);font-size:.75rem;">
                        @req.Initial
                    </div>
                }
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-bold small text-dark text-truncate">@req.DisplayLabel</div>
                    <div class="text-muted" style="font-size:.7rem;">@req.Email</div>
                </div>
                <div class="d-flex gap-2 flex-shrink-0">
                    <button class="btn btn-sm btn-success rounded-pill px-3"
                            @onclick="() => Approve(req)"
                            disabled="@_acting">
                        Aprobar
                    </button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                            @onclick="() => Reject(req)"
                            disabled="@_acting">
                        Rechazar
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Managed Groups -->
@if (Data?.ManagedGroups?.Count > 0)
{
    <h5 class="fw-bold mb-3">Mis Grupos</h5>
    <div class="row g-3 mb-5">
        @foreach (var g in Data.ManagedGroups)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card-uerre p-3">
                    <a href="/groups/@g.Slug" class="text-decoration-none d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-2 d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                             style="width:40px;height:40px;background:var(--uerre-purple);">
                            @g.Name.Substring(0,1)
                        </div>
                        <div class="min-w-0">
                            <div class="fw-bold small text-dark text-truncate">@g.Name</div>
                            <div class="text-muted" style="font-size:.7rem;">@g.MemberCount miembros</div>
                        </div>
                    </a>

                    <!-- Leader badge customization: border color + Presidente/Presidenta -->
                    <div class="leader-badge-editor pt-3 border-top">
                        <div class="text-muted small fw-semibold mb-2">Tu insignia en Miembros</div>

                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                            @foreach (var (hex, name) in LeaderBadgeOptions.Colors)
                            {
                                <button type="button"
                                        class="leader-badge-swatch @(_badgeColor.GetValueOrDefault(g.Id) == hex ? "leader-badge-swatch--selected" : "")"
                                        style="background:@hex;"
                                        title="@name"
                                        aria-label="@name"
                                        @onclick="() => SelectBadgeColor(g.Id, hex)"></button>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                            @foreach (var title in LeaderBadgeOptions.Titles)
                            {
                                <button type="button"
                                        class="btn btn-sm rounded-pill px-3 @(_badgeTitle.GetValueOrDefault(g.Id) == title ? "btn-uerre-primary" : "btn-uerre-outline")"
                                        @onclick="() => SelectBadgeTitle(g.Id, title)">
                                    @title
                                </button>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-uerre-primary px-3"
                                    @onclick="() => SaveBadge(g.Id)"
                                    disabled="@_savingBadge.Contains(g.Id)">
                                @(_savingBadge.Contains(g.Id) ? "Guardando..." : "Guardar")
                            </button>
                            @if (_badgeSaved.Contains(g.Id))
                            {
                                <span class="text-success small">Guardado ✓</span>
                            }
                        </div>
                        @if (_badgeError.TryGetValue(g.Id, out var badgeErr))
                        {
                            <div class="text-danger small mt-2">@badgeErr</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <h5 class="fw-bold mb-3">Miembros Activos</h5>
    <div class="d-flex flex-column gap-3 mb-5">
        @foreach (var g in Data.ManagedGroups)
        {
            var isLoading = _loadingGroups.Contains(g.Id);
            var members = _groupMembers.GetValueOrDefault(g.Id, []);
            <div class="card-uerre p-3">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <div>
                        <div class="fw-bold small text-dark">@g.Name</div>
                        <div class="text-muted" style="font-size:.72rem;">@members.Count miembros cargados</div>
                    </div>
                    <button class="btn btn-sm btn-uerre-outline rounded-pill px-3"
                            @onclick="() => ToggleMembers(g.Id)"
                            disabled="@_acting">
                        @(_expandedGroupId == g.Id ? "Ocultar" : "Ver miembros")
                    </button>
                </div>

                @if (_expandedGroupId == g.Id)
                {
                    if (isLoading)
                    {
                        <div class="d-flex justify-content-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                    }
                    else if (members.Count == 0)
                    {
                        <p class="text-muted small mb-0">Sin miembros activos.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 mt-2">
                            @foreach (var member in members)
                            {
                                <div class="border rounded-3 px-3 py-2 bg-white">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="fw-semibold small text-dark text-truncate">@member.DisplayLabel</span>
                                                @if (member.BadgeTitle is not null)
                                                {
                                                    <span class="member-leader-tag" style="background:@member.BadgeColor;">@member.BadgeTitle</span>
                                                }
                                            </div>
                                            <div class="text-muted" style="font-size:.7rem;">@member.Email</div>
                                        </div>
                                        <div class="d-flex gap-2 flex-shrink-0">
                                            <button class="btn btn-sm btn-uerre-outline rounded-pill px-3"
                                                    @onclick="() => ToggleMemberBadgeEditor(member)"
                                                    disabled="@_acting">
                                                @(_editingMemberId == member.UserId ? "Cerrar" : "Personalizar")
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    @onclick="() => RemoveMember(g.Id, member.UserId)"
                                                    disabled="@_acting">
                                                Eliminar
                                            </button>
                                        </div>
                                    </div>

                                    @if (_editingMemberId == member.UserId)
                                    {
                                        <div class="leader-badge-editor mt-3 pt-3 border-top">
                                            <div class="text-muted small fw-semibold mb-2">Asignar rol e insignia</div>

                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm"
                                                       placeholder="Ej. Secretario, Tesorero, Vocal..."
                                                       maxlength="@LeaderBadgeOptions.MaxAssignedTitleLength"
                                                       value="@_memberBadgeTitle.GetValueOrDefault(member.UserId)"
                                                       @oninput="e => SelectMemberBadgeTitle(member.UserId, AsString(e.Value))" />
                                            </div>

                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                                                @foreach (var (hex, name) in LeaderBadgeOptions.Colors)
                                                {
                                                    <button type="button"
                                                            class="leader-badge-swatch @(_memberBadgeColor.GetValueOrDefault(member.UserId) == hex ? "leader-badge-swatch--selected" : "")"
                                                            style="background:@hex;"
                                                            title="@name"
                                                            aria-label="@name"
                                                            @onclick="() => SelectMemberBadgeColor(member.UserId, hex)"></button>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-uerre-primary px-3"
                                                        @onclick="() => SaveMemberBadge(g.Id, member.UserId)"
                                                        disabled="@_savingMemberBadge.Contains(member.UserId)">
                                                    @(_savingMemberBadge.Contains(member.UserId) ? "Guardando..." : "Guardar")
                                                </button>
                                                @if (member.BadgeTitle is not null)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link text-danger px-2"
                                                            @onclick="() => RemoveMemberBadge(g.Id, member.UserId)"
                                                            disabled="@_savingMemberBadge.Contains(member.UserId)">
                                                        Quitar insignia
                                                    </button>
                                                }
                                            </div>
                                            @if (_memberBadgeError.TryGetValue(member.UserId, out var memberBadgeErr))
                                            {
                                                <div class="text-danger small mt-2">@memberBadgeErr</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<!-- Upcoming Events -->
@if (Data?.UpcomingEvents?.Count > 0)
{
    <h5 class="fw-bold mb-3">Próximos Eventos</h5>
    <div class="row g-3 mb-5">
        @foreach (var ev in Data.UpcomingEvents)
        {
            <div class="col-12 col-md-6">
                <a href="/events/@ev.Id" class="text-decoration-none">
                    <div class="card-event">
                        <div class="event-date-badge">
                            <span class="event-date-month">@ev.MonthLabel</span>
                            <span class="event-date-day">@ev.DayLabel</span>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-bold small text-dark text-truncate">@ev.Title</div>
                            <div class="text-muted" style="font-size:.7rem;">@ev.GroupName</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<NotificationsPanel Notifications="Notifications" UnreadCount="UnreadCount"
                    MarkingAll="MarkingAll" OnMarkAllRead="OnMarkAllRead" OnMarkRead="OnMarkRead" />

@code {
    [Parameter] public DashboardLeaderModel? Data { get; set; }
    [Parameter] public List<NotificationModel> Notifications { get; set; } = [];
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public bool MarkingAll { get; set; }
    [Parameter] public EventCallback OnMarkAllRead { get; set; }
    [Parameter] public EventCallback<Guid> OnMarkRead { get; set; }

    private bool _acting;
    private Guid? _expandedGroupId;
    private readonly Dictionary<Guid, List<GroupMemberModel>> _groupMembers = [];
    private readonly HashSet<Guid> _loadingGroups = [];

    // Leader badge customization: per-group selected color/title, load-once guard,
    // saving state, a persistent "Guardado" flag (cleared on further edits), and errors.
    private readonly Dictionary<Guid, string> _badgeColor = [];
    private readonly Dictionary<Guid, string> _badgeTitle = [];
    private readonly HashSet<Guid> _badgeLoaded = [];
    private readonly HashSet<Guid> _savingBadge = [];
    private readonly HashSet<Guid> _badgeSaved = [];
    private readonly Dictionary<Guid, string> _badgeError = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Data?.ManagedGroups is null) return;

        // Sequential on purpose — a leader typically manages one or two groups,
        // and this avoids sharing a single EF DbContext across concurrent calls.
        foreach (var g in Data.ManagedGroups)
        {
            if (!_badgeLoaded.Add(g.Id)) continue;
            var (title, color) = await GroupService.GetMyLeaderBadgeAsync(g.Id);
            _badgeTitle[g.Id] = title;
            _badgeColor[g.Id] = color;
        }
    }

    private void SelectBadgeColor(Guid groupId, string color)
    {
        _badgeColor[groupId] = color;
        _badgeSaved.Remove(groupId);
    }

    private void SelectBadgeTitle(Guid groupId, string title)
    {
        _badgeTitle[groupId] = title;
        _badgeSaved.Remove(groupId);
    }

    private async Task SaveBadge(Guid groupId)
    {
        _savingBadge.Add(groupId);
        _badgeError.Remove(groupId);
        try
        {
            var color = _badgeColor.GetValueOrDefault(groupId, LeaderBadgeOptions.DefaultColor);
            var title = _badgeTitle.GetValueOrDefault(groupId, LeaderBadgeOptions.DefaultTitle);
            await GroupService.UpdateMyLeaderBadgeAsync(groupId, color, title);
            _badgeSaved.Add(groupId);
        }
        catch (InvalidOperationException ex)
        {
            _badgeError[groupId] = ex.Message;
        }
        catch
        {
            _badgeError[groupId] = "No se pudo guardar. Intenta de nuevo.";
        }
        finally
        {
            _savingBadge.Remove(groupId);
            StateHasChanged();
        }
    }

    // Per-member badge assignment (leader assigning a role/color to someone else in the
    // expanded member list). Only one member's editor is open at a time.
    private Guid? _editingMemberId;
    private readonly Dictionary<Guid, string> _memberBadgeColor = [];
    private readonly Dictionary<Guid, string> _memberBadgeTitle = [];
    private readonly HashSet<Guid> _savingMemberBadge = [];
    private readonly Dictionary<Guid, string> _memberBadgeError = [];

    private void ToggleMemberBadgeEditor(GroupMemberModel member)
    {
        if (_editingMemberId == member.UserId)
        {
            _editingMemberId = null;
            return;
        }

        _editingMemberId = member.UserId;
        _memberBadgeColor[member.UserId] = member.BadgeColor ?? LeaderBadgeOptions.DefaultColor;
        _memberBadgeTitle[member.UserId] = member.BadgeTitle ?? "";
        _memberBadgeError.Remove(member.UserId);
    }

    private void SelectMemberBadgeColor(Guid userId, string color) => _memberBadgeColor[userId] = color;
    private void SelectMemberBadgeTitle(Guid userId, string title) => _memberBadgeTitle[userId] = title;
    private static string AsString(object? value) => value?.ToString() ?? string.Empty;

    private async Task SaveMemberBadge(Guid groupId, Guid userId)
    {
        _savingMemberBadge.Add(userId);
        _memberBadgeError.Remove(userId);
        try
        {
            var color = _memberBadgeColor.GetValueOrDefault(userId, LeaderBadgeOptions.DefaultColor);
            var title = _memberBadgeTitle.GetValueOrDefault(userId, "");
            await GroupService.AssignMemberBadgeAsync(groupId, userId, color, title);
            ReplaceMemberBadgeLocally(groupId, userId, title.Trim(), color);
            _editingMemberId = null;
        }
        catch (InvalidOperationException ex)
        {
            _memberBadgeError[userId] = ex.Message;
        }
        catch
        {
            _memberBadgeError[userId] = "No se pudo guardar. Intenta de nuevo.";
        }
        finally
        {
            _savingMemberBadge.Remove(userId);
            StateHasChanged();
        }
    }

    private async Task RemoveMemberBadge(Guid groupId, Guid userId)
    {
        _savingMemberBadge.Add(userId);
        _memberBadgeError.Remove(userId);
        try
        {
            await GroupService.RemoveMemberBadgeAsync(groupId, userId);
            ReplaceMemberBadgeLocally(groupId, userId, null, null);
            _editingMemberId = null;
        }
        catch
        {
            _memberBadgeError[userId] = "No se pudo quitar la insignia. Intenta de nuevo.";
        }
        finally
        {
            _savingMemberBadge.Remove(userId);
            StateHasChanged();
        }
    }

    private void ReplaceMemberBadgeLocally(Guid groupId, Guid userId, string? title, string? color)
    {
        if (!_groupMembers.TryGetValue(groupId, out var members)) return;
        var idx = members.FindIndex(m => m.UserId == userId);
        if (idx >= 0)
            members[idx] = members[idx] with { BadgeTitle = title, BadgeColor = color };
    }

    private async Task Approve(MembershipModel req)
    {
        _acting = true;
        try
        {
            await GroupService.ApproveMembershipAsync(req.GroupId, req.MembershipId);
            Data?.PendingMembershipRequests?.Remove(req);
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }

    private async Task Reject(MembershipModel req)
    {
        _acting = true;
        try
        {
            await GroupService.RejectMembershipAsync(req.GroupId, req.MembershipId);
            Data?.PendingMembershipRequests?.Remove(req);
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }

    private async Task ToggleMembers(Guid groupId)
    {
        if (_expandedGroupId == groupId)
        {
            _expandedGroupId = null;
            return;
        }

        _expandedGroupId = groupId;
        if (_groupMembers.ContainsKey(groupId)) return;

        _loadingGroups.Add(groupId);
        try
        {
            _groupMembers[groupId] = await GroupService.GetMembersAsync(groupId);
        }
        finally
        {
            _loadingGroups.Remove(groupId);
            StateHasChanged();
        }
    }

    private async Task RemoveMember(Guid groupId, Guid userId)
    {
        _acting = true;
        try
        {
            await GroupService.RemoveMemberAsync(groupId, userId);
            if (_groupMembers.TryGetValue(groupId, out var members))
                _groupMembers[groupId] = members.Where(m => m.UserId != userId).ToList();
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }
}
