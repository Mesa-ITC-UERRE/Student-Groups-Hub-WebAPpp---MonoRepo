@* Leader Dashboard sub-component *@
@inject GroupApiService GroupService

<!-- Pending membership requests with inline approve/reject -->
@if (Data?.PendingMembershipRequests?.Count > 0)
{
    <h5 class="fw-bold mb-3">
        Solicitudes Pendientes
        <span class="badge rounded-pill ms-1 text-white" style="background:var(--uerre-purple);font-size:.7rem;">
            @Data.PendingMembershipRequests.Count
        </span>
    </h5>
    <div class="d-flex flex-column gap-2 mb-5">
        @foreach (var req in Data.PendingMembershipRequests)
        {
            <div class="card-uerre p-3 d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(req.AvatarUrl))
                {
                    <img src="@req.AvatarUrl" alt=""
                         class="rounded-circle flex-shrink-0"
                         style="width:36px;height:36px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:36px;height:36px;background:var(--uerre-purple);font-size:.75rem;">
                        @req.Initial
                    </div>
                }
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-bold small text-dark text-truncate">@req.DisplayLabel</div>
                    <div class="text-muted" style="font-size:.7rem;">@req.Email</div>
                </div>
                <div class="d-flex gap-2 flex-shrink-0">
                    <button class="btn btn-sm btn-success rounded-pill px-3"
                            @onclick="() => Approve(req)"
                            disabled="@_acting">
                        Aprobar
                    </button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                            @onclick="() => Reject(req)"
                            disabled="@_acting">
                        Rechazar
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Managed Groups -->
@if (Data?.ManagedGroups?.Count > 0)
{
    <h5 class="fw-bold mb-3">Mis Grupos</h5>
    <div class="row g-3 mb-5">
        @foreach (var g in Data.ManagedGroups)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <a href="/groups/@g.Slug" class="text-decoration-none">
                    <div class="card-uerre p-3 d-flex align-items-center gap-3">
                        <div class="rounded-2 d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                             style="width:40px;height:40px;background:var(--uerre-purple);">
                            @g.Name.Substring(0,1)
                        </div>
                        <div class="min-w-0">
                            <div class="fw-bold small text-dark text-truncate">@g.Name</div>
                            <div class="text-muted" style="font-size:.7rem;">@g.MemberCount miembros</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <h5 class="fw-bold mb-3">Miembros Activos</h5>
    <div class="d-flex flex-column gap-3 mb-5">
        @foreach (var g in Data.ManagedGroups)
        {
            var isLoading = _loadingGroups.Contains(g.Id);
            var members = _groupMembers.GetValueOrDefault(g.Id, []);
            <div class="card-uerre p-3">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <div>
                        <div class="fw-bold small text-dark">@g.Name</div>
                        <div class="text-muted" style="font-size:.72rem;">@members.Count miembros cargados</div>
                    </div>
                    <button class="btn btn-sm btn-uerre-outline rounded-pill px-3"
                            @onclick="() => ToggleMembers(g.Id)"
                            disabled="@_acting">
                        @(_expandedGroupId == g.Id ? "Ocultar" : "Ver miembros")
                    </button>
                </div>

                @if (_expandedGroupId == g.Id)
                {
                    if (isLoading)
                    {
                        <div class="d-flex justify-content-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                    }
                    else if (members.Count == 0)
                    {
                        <p class="text-muted small mb-0">Sin miembros activos.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 mt-2">
                            @foreach (var member in members)
                            {
                                <div class="d-flex align-items-center gap-3 border rounded-3 px-3 py-2 bg-white">
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold small text-dark text-truncate">@member.DisplayLabel</div>
                                        <div class="text-muted" style="font-size:.7rem;">@member.Email</div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            @onclick="() => RemoveMember(g.Id, member.UserId)"
                                            disabled="@_acting">
                                        Eliminar
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<!-- Upcoming Events -->
@if (Data?.UpcomingEvents?.Count > 0)
{
    <h5 class="fw-bold mb-3">Próximos Eventos</h5>
    <div class="row g-3 mb-5">
        @foreach (var ev in Data.UpcomingEvents)
        {
            <div class="col-12 col-md-6">
                <a href="/events/@ev.Id" class="text-decoration-none">
                    <div class="card-event">
                        <div class="event-date-badge">
                            <span class="event-date-month">@ev.MonthLabel</span>
                            <span class="event-date-day">@ev.DayLabel</span>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-bold small text-dark text-truncate">@ev.Title</div>
                            <div class="text-muted" style="font-size:.7rem;">@ev.GroupName</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<NotificationsPanel Notifications="Notifications" UnreadCount="UnreadCount"
                    MarkingAll="MarkingAll" OnMarkAllRead="OnMarkAllRead" OnMarkRead="OnMarkRead" />

@code {
    [Parameter] public DashboardLeaderModel? Data { get; set; }
    [Parameter] public List<NotificationModel> Notifications { get; set; } = [];
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public bool MarkingAll { get; set; }
    [Parameter] public EventCallback OnMarkAllRead { get; set; }
    [Parameter] public EventCallback<Guid> OnMarkRead { get; set; }

    private bool _acting;
    private Guid? _expandedGroupId;
    private readonly Dictionary<Guid, List<GroupMemberModel>> _groupMembers = [];
    private readonly HashSet<Guid> _loadingGroups = [];

    private async Task Approve(MembershipModel req)
    {
        _acting = true;
        try
        {
            await GroupService.ApproveMembershipAsync(req.GroupId, req.MembershipId);
            Data?.PendingMembershipRequests?.Remove(req);
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }

    private async Task Reject(MembershipModel req)
    {
        _acting = true;
        try
        {
            await GroupService.RejectMembershipAsync(req.GroupId, req.MembershipId);
            Data?.PendingMembershipRequests?.Remove(req);
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }

    private async Task ToggleMembers(Guid groupId)
    {
        if (_expandedGroupId == groupId)
        {
            _expandedGroupId = null;
            return;
        }

        _expandedGroupId = groupId;
        if (_groupMembers.ContainsKey(groupId)) return;

        _loadingGroups.Add(groupId);
        try
        {
            _groupMembers[groupId] = await GroupService.GetManagedMembersAsync(groupId);
        }
        finally
        {
            _loadingGroups.Remove(groupId);
            StateHasChanged();
        }
    }

    private async Task RemoveMember(Guid groupId, Guid userId)
    {
        _acting = true;
        try
        {
            await GroupService.RemoveMemberAsync(groupId, userId);
            if (_groupMembers.TryGetValue(groupId, out var members))
                _groupMembers[groupId] = members.Where(m => m.UserId != userId).ToList();
        }
        finally
        {
            _acting = false;
            StateHasChanged();
        }
    }
}
