@page "/calendario"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject CalendarApiService CalendarSvc
@attribute [Authorize]

<PageTitle>Calendario — Grupos Estudiantiles Hub</PageTitle>

<div class="page-header">
    <div class="container-uerre d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="text-white fw-bold mb-1" style="font-size:clamp(1.5rem,4vw,2.25rem);">
                Calendario
            </h1>
            <p class="mb-0" style="color:rgba(255,255,255,.7);">
                Eventos de tus grupos y de toda la plataforma.
            </p>
        </div>
        <!-- Legend -->
        <div class="calendar-legend-card d-flex gap-3 flex-wrap align-items-center">
            <span class="calendar-legend-item d-flex align-items-center gap-2">
                <span class="calendar-legend-dot calendar-legend-dot--mine"></span>
                Mis grupos
            </span>
            <span class="calendar-legend-item d-flex align-items-center gap-2">
                <span class="calendar-legend-dot calendar-legend-dot--other"></span>
                Otros eventos
            </span>
        </div>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre">

        @if (_loading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-uerre"></div>
            </div>
        }
        else
        {
            <!-- Month navigator -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <button class="btn btn-uerre-outline btn-sm d-inline-flex align-items-center gap-1 px-3"
                        @onclick="PrevMonth" disabled="@_navigating">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.733 19.79a.75.75 0 0 0 1.034-1.083l-5.963-5.707H20.25a.75.75 0 0 0 0-1.5H5.804l5.963-5.707a.75.75 0 0 0-1.034-1.083l-7.25 6.938a.75.75 0 0 0 0 1.083z"/></svg>
                    Anterior
                </button>
                <h4 class="fw-bold mb-0 text-capitalize" style="font-size:1.1rem;">
                    @CurrentMonthModel?.MonthLabel
                </h4>
                <button class="btn btn-uerre-outline btn-sm d-inline-flex align-items-center gap-1 px-3"
                        @onclick="NextMonth" disabled="@_navigating">
                    Siguiente
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.267 4.21a.75.75 0 0 0-1.034 1.082l5.963 5.708H3.75a.75.75 0 0 0 0 1.5h14.446l-5.963 5.707a.75.75 0 0 0 1.034 1.083l7.25-6.938a.75.75 0 0 0 0-1.083z"/></svg>
                </button>
            </div>

            @if (_navigating)
            {
                <div class="d-flex justify-content-center py-4">
                    <div class="spinner-uerre"></div>
                </div>
            }
            else if (CurrentMonthModel is not null)
            {
                var year        = _displayYear;
                var month       = _displayMonth;
                var firstDay    = new DateTime(year, month, 1);
                var daysInMonth = DateTime.DaysInMonth(year, month);
                // Monday-based: Mon=0 … Sun=6
                var startDow  = ((int)firstDay.DayOfWeek + 6) % 7;
                var dayEvents = CurrentMonthModel.Days.ToDictionary(d => d.Date);

                <!-- Day headers -->
                <div class="calendar-grid mb-1">
                    @foreach (var d in new[]{"Lun","Mar","Mié","Jue","Vie","Sáb","Dom"})
                    {
                        <div class="calendar-day-header">@d</div>
                    }
                </div>

                <!-- Day cells -->
                <div class="calendar-grid">
                    @* Leading empty cells *@
                    @for (int i = 0; i < startDow; i++)
                    {
                        <div class="calendar-cell calendar-cell--empty"></div>
                    }

                    @* Day cells *@
                    @for (int day = 1; day <= daysInMonth; day++)
                    {
                        var date   = new DateOnly(year, month, day);
                        var isToday = date == DateOnly.FromDateTime(DateTime.Today);
                        var hasSel = _selectedDay == date;
                        dayEvents.TryGetValue(date, out var dayData);

                        var myCount  = dayData?.MyGroupEvents.Count ?? 0;
                        var allCount = dayData?.AllEvents.Count    ?? 0;
                        var hasAny   = myCount + allCount > 0;

                        <div class="calendar-cell @(isToday ? "calendar-cell--today" : "") @(hasSel ? "calendar-cell--selected" : "") @(hasAny ? "calendar-cell--has-events" : "")"
                             @onclick="() => SelectDay(date, dayData)">
                            <span class="calendar-day-number">@day</span>

                            @if (hasAny)
                            {
                                <div class="calendar-indicators">
                                    @if (myCount > 0)
                                    {
                                        <span class="calendar-indicator calendar-indicator--mine"
                                              title="@myCount evento(s) de mis grupos">
                                            <span class="calendar-indicator-dot"></span>
                                            @myCount
                                        </span>
                                    }
                                    @if (allCount > 0)
                                    {
                                        <span class="calendar-indicator calendar-indicator--other"
                                              title="@allCount otro(s) evento(s)">
                                            <span class="calendar-indicator-dot"></span>
                                            @allCount
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Selected day event list -->
                @if (_selectedDay.HasValue && _selectedDayData is not null)
                {
                    var allDayEvents = _selectedDayData.MyGroupEvents
                        .Concat(_selectedDayData.AllEvents)
                        .OrderBy(e => e.StartAt)
                        .ToList();

                    <div class="card-uerre p-4 mt-4">
                        <h6 class="fw-bold mb-3">
                            @_selectedDay.Value.ToString("dddd, d \'de\' MMMM")
                            <span class="badge rounded-pill ms-2 text-white"
                                  style="background:var(--uerre-purple);font-size:.65rem;">
                                @allDayEvents.Count
                            </span>
                        </h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var ev in allDayEvents)
                            {
                                var isMine = _selectedDayData.MyGroupEvents.Any(e => e.Id == ev.Id);
                                <a href="/events/@ev.Id" class="text-decoration-none">
                                    <div class="d-flex align-items-start gap-3 p-2 rounded-3"
                                         style="background:@(isMine ? "var(--uerre-tag-bg)" : "#fffbeb");">
                                        <div class="flex-shrink-0 rounded-2 d-flex align-items-center justify-content-center"
                                             style="width:6px;height:100%;min-height:40px;background:@(isMine ? "var(--uerre-purple)" : "var(--uerre-gold)");"></div>
                                        <div class="min-w-0">
                                            <div class="fw-semibold small text-dark line-clamp-1">@ev.Title</div>
                                            <div class="text-muted" style="font-size:.72rem;">
                                                @ev.GroupName · @ev.StartAt.ToLocalTime().ToString("HH:mm")
                                                @if (ev.Location is not null)
                                                {
                                                    <span> · @ev.Location</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
                else if (_selectedDay.HasValue)
                {
                    <div class="card-uerre no-hover p-3 mt-4 text-center text-muted small">
                        No hay eventos para este día.
                    </div>
                }
            }
        }
    </div>
</section>

@code {
    private List<CalendarMonthModel> _months = [];
    private bool _loading  = true;
    private bool _navigating;

    private int _displayYear  = DateTime.Today.Year;
    private int _displayMonth = DateTime.Today.Month;

    // The three pre-loaded months are: [prev, current, next]
    private CalendarMonthModel? CurrentMonthModel =>
        _months.FirstOrDefault(m => m.Year == _displayYear && m.Month == _displayMonth);

    private DateOnly? _selectedDay;
    private CalendarDayModel? _selectedDayData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _months = await CalendarSvc.GetCalendarAsync(_displayYear, _displayMonth);
        }
        catch { _months = []; }
        finally { _loading = false; }
    }

    private void SelectDay(DateOnly date, CalendarDayModel? data)
    {
        if (_selectedDay == date) { _selectedDay = null; _selectedDayData = null; }
        else                      { _selectedDay = date; _selectedDayData = data; }
    }

    private async Task PrevMonth()
    {
        _navigating = true;
        _selectedDay = null; _selectedDayData = null;
        var d = new DateTime(_displayYear, _displayMonth, 1).AddMonths(-1);
        _displayYear  = d.Year;
        _displayMonth = d.Month;
        // Check if we already have this month pre-loaded
        if (CurrentMonthModel is null)
            _months = await CalendarSvc.GetCalendarAsync(_displayYear, _displayMonth);
        _navigating = false;
    }

    private async Task NextMonth()
    {
        _navigating = true;
        _selectedDay = null; _selectedDayData = null;
        var d = new DateTime(_displayYear, _displayMonth, 1).AddMonths(1);
        _displayYear  = d.Year;
        _displayMonth = d.Month;
        if (CurrentMonthModel is null)
            _months = await CalendarSvc.GetCalendarAsync(_displayYear, _displayMonth);
        _navigating = false;
    }
}
