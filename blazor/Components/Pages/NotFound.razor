@page "/not-found"
@layout Layout.MainLayout

<PageTitle>Página no encontrada — Student Groups Hub</PageTitle>

<section class="py-5 text-center">
    <div class="container">
        <div class="py-5">
            <div class="empty-icon" style="font-size:2rem;color:var(--uerre-muted);">&#9632;</div>
            <h1 class="display-4 fw-bold mt-3" style="color:var(--uerre-purple);">404</h1>
            <h2 class="fw-bold mb-3">Página no encontrada</h2>
            <p class="text-muted mb-4" style="max-width:400px;margin:0 auto;">
                Lo sentimos, no pudimos encontrar la página que buscas.
            </p>
            <a href="/" class="btn btn-uerre-primary px-5">Volver al inicio</a>
        </div>
    </div>
</section>
