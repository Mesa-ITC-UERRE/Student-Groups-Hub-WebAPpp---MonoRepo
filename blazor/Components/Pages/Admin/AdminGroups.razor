@page "/admin/groups"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminApiService AdminService
@inject GroupApiService GroupService
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Gestionar Grupos — Admin</PageTitle>

<div class="page-header">
    <div class="container-uerre">
        <a href="/admin" class="text-white-50 text-decoration-none small mb-2 d-inline-block">
            &larr; Panel Admin
        </a>
        <h1 class="text-white fw-bold mb-1" style="font-size:clamp(1.5rem,4vw,2.25rem);">
            Gestionar Grupos
        </h1>
        <p class="mb-0" style="color:rgba(255,255,255,.7);">
            Todos los grupos de la plataforma — activos, pendientes e inactivos.
        </p>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre">

        <!-- Filters -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
            <div class="search-input-wrapper" style="flex:1;min-width:220px;max-width:360px;">
                <span class="search-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15M3.5 10a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0m15.584 5.17 3.123 3.123a.75.75 0 0 1-1.06 1.06l-3.123-3.122a8 8 0 0 0 1.06-1.061"/></svg></span>
                <input type="search" class="form-control rounded-3"
                       placeholder="Buscar grupos..."
                       value="@_search" @oninput="OnSearch" />
            </div>
            <select class="form-select rounded-3" style="max-width:180px;"
                    @onchange="OnStatusFilter">
                <option value="">Todos los estados</option>
                <option value="active">Activos</option>
                <option value="pending">Pendientes</option>
                <option value="inactive">Inactivos</option>
                <option value="rejected">Rechazados</option>
            </select>
            <button class="btn btn-sm btn-uerre-primary rounded-pill px-4 ms-md-auto"
                    type="button" @onclick="ToggleSeasonReset" disabled="@_resettingSeason">
                Nuevo Periodo
            </button>
        </div>

        @if (_showSeasonReset)
        {
            <div class="card-uerre no-hover p-4 mb-4">
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                    <div>
                        <h6 class="fw-bold mb-1">Nuevo Periodo</h6>
                        <p class="text-muted small mb-0">
                            Reinicia los grupos seleccionados: elimina líderes, cierra administraciones activas, remueve miembros aceptados y rechaza solicitudes pendientes.
                        </p>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                            type="button" @onclick="ToggleSeasonReset" disabled="@_resettingSeason">
                        Cerrar
                    </button>
                </div>

                @if (_seasonGroupsLoading)
                {
                    <div class="d-flex justify-content-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                }
                else if (_seasonGroups.Count == 0)
                {
                    <p class="text-muted small mb-0">No hay grupos activos para reiniciar.</p>
                }
                else
                {
                    <div class="rounded-3 border overflow-hidden mb-3" style="max-height:320px;overflow-y:auto;">
                        @foreach (var group in _seasonGroups)
                        {
                            <label class="d-flex align-items-center gap-3 px-3 py-2 border-bottom bg-white" style="cursor:pointer;">
                                <input class="form-check-input mt-0" type="checkbox"
                                       checked="@(!_seasonSkipGroupIds.Contains(group.Id))"
                                       @onchange="e => ToggleSeasonGroup(group.Id, (bool)(e.Value ?? false))" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold small text-dark">@group.Name</div>
                                    <div class="text-muted" style="font-size:.72rem;">@group.MemberCount miembros</div>
                                </div>
                                <span class="text-muted small">Incluir</span>
                            </label>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary rounded-pill px-4"
                                type="button" @onclick="ToggleSeasonReset" disabled="@_resettingSeason">
                            Cancelar
                        </button>
                        <button class="btn btn-danger rounded-pill px-4"
                                type="button" @onclick="ConfirmSeasonReset" disabled="@_resettingSeason">
                            @if (_resettingSeason) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Reiniciar grupos seleccionados
                        </button>
                    </div>
                }
            </div>
        }

        @if (_loading)
        {
            <div class="d-flex justify-content-center py-5"><div class="spinner-uerre"></div></div>
        }
        else if (_groups.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15M3.5 10a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0m15.584 5.17 3.123 3.123a.75.75 0 0 1-1.06 1.06l-3.123-3.122a8 8 0 0 0 1.06-1.061"/></svg></div>
                <h5 class="fw-bold mb-1">Sin resultados</h5>
                <p class="text-muted small">Intenta con otros filtros.</p>
            </div>
        }
        else
        {
            <div class="card-uerre overflow-hidden mb-4">
                <table class="table table-uerre mb-0">
                    <thead>
                        <tr>
                            <th class="py-3 px-4">Grupo</th>
                            <th class="py-3 px-4">Categoría</th>
                            <th class="py-3 px-4">Miembros</th>
                            <th class="py-3 px-4">Estado</th>
                            <th class="py-3 px-4">Creado</th>
                            <th class="py-3 px-4 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in _groups)
                        {
                            <tr>
                                <td class="py-3 px-4 align-middle">
                                    <div class="fw-semibold text-dark small">@group.Name</div>
                                    <div class="text-muted" style="font-size:.7rem;">@group.Slug</div>
                                </td>
                                <td class="py-3 px-4 align-middle">
                                    @if (group.Category is not null)
                                    {
                                        <span class="tag-uerre">@group.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="py-3 px-4 align-middle small text-muted">
                                    @group.MemberCount
                                </td>
                                <td class="py-3 px-4 align-middle">
                                    <span class="badge rounded-pill @StatusCss(group.Status)"
                                          style="font-size:.7rem;">
                                        @StatusLabel(group.Status)
                                    </span>
                                </td>
                                <td class="py-3 px-4 align-middle small text-muted">
                                    @group.CreatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="py-3 px-4 align-middle text-end">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        <a href="/groups/@group.Slug"
                                           class="btn btn-xs btn-uerre-outline rounded-2">
                                            Ver
                                        </a>
                                        <button class="btn btn-xs @(_expandedGroupId == group.Id ? "btn-uerre-primary" : "btn-uerre-outline") rounded-2"
                                                @onclick="() => ToggleMembersPanel(group.Id)">
                                            Miembros
                                        </button>
                                        @if (group.Status == "active")
                                        {
                                            <button class="btn btn-xs btn-outline-warning rounded-2"
                                                    @onclick="() => Deactivate(group.Id)"
                                                    disabled="@_acting">
                                                Desactivar
                                            </button>
                                        }
                                        else if (group.Status == "inactive")
                                        {
                                            <button class="btn btn-xs btn-outline-success rounded-2"
                                                    @onclick="() => Activate(group.Id)"
                                                    disabled="@_acting">
                                                Activar
                                            </button>
                                        }
                                        else if (group.Status == "pending")
                                        {
                                            <button class="btn btn-xs btn-outline-success rounded-2"
                                                    @onclick="() => Activate(group.Id)"
                                                    disabled="@_acting">
                                                Aprobar
                                            </button>
                                            <button class="btn btn-xs btn-outline-danger rounded-2"
                                                    @onclick="() => Reject(group.Id)"
                                                    disabled="@_acting">
                                                Rechazar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>

                            @if (_expandedGroupId == group.Id)
                            {
                                <tr style="background:var(--uerre-surface,#f8f9fa);">
                                    <td colspan="6" class="p-0 border-top-0">
                                        <div class="px-4 py-3 border-top border-2" style="border-color:var(--uerre-primary,#c8102e)!important;">

                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <h6 class="fw-bold mb-0 small">
                                                    Gestionar miembros — <span class="text-muted fw-normal">@group.Name</span>
                                                </h6>
                                                @if (group.Status == "active")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                            type="button"
                                                            @onclick="() => ResetGroupSeason(group.Id)"
                                                            disabled="@_resettingSeason">
                                                        Reiniciar ciclo
                                                    </button>
                                                }
                                            </div>

                                            <!-- Tabs -->
                                            <div class="d-flex gap-2 mb-3">
                                                <button class="btn btn-sm @(_memberTab == "pending" ? "btn-uerre-primary" : "btn-uerre-outline") rounded-2"
                                                        @onclick='() => _memberTab = "pending"'>
                                                    Solicitudes pendientes
                                                    @if (_pendingList.Count > 0)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem;">
                                                            @_pendingList.Count
                                                        </span>
                                                    }
                                                </button>
                                                <button class="btn btn-sm @(_memberTab == "active" ? "btn-uerre-primary" : "btn-uerre-outline") rounded-2"
                                                        @onclick='() => _memberTab = "active"'>
                                                    Miembros activos
                                                    @if (_memberList.Count > 0)
                                                    {
                                                        <span class="badge bg-secondary ms-1" style="font-size:.65rem;">
                                                            @_memberList.Count
                                                        </span>
                                                    }
                                                </button>
                                            </div>

                                            @if (_memberLoading)
                                            {
                                                <div class="d-flex justify-content-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                                                </div>
                                            }
                                            else if (_memberTab == "pending")
                                            {
                                                @if (_pendingList.Count == 0)
                                                {
                                                    <p class="text-muted small mb-0 py-2">Sin solicitudes pendientes.</p>
                                                }
                                                else
                                                {
                                                    <div class="rounded-3 overflow-hidden border" style="max-height:300px;overflow-y:auto;">
                                                        @foreach (var m in _pendingList)
                                                        {
                                                            var pm = m;
                                                            var pgId = group.Id;
                                                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-white">
                                                                <div>
                                                                    <div class="fw-semibold small">@pm.DisplayLabel</div>
                                                                    <div class="text-muted" style="font-size:.7rem;">@pm.Email</div>
                                                                    <div class="text-muted" style="font-size:.65rem;">
                                                                        Solicitado @pm.RequestedAt.ToString("dd MMM yyyy")
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex gap-2 flex-shrink-0">
                                                                    <button class="btn btn-xs btn-outline-success rounded-2"
                                                                            @onclick="() => ApproveMember(pgId, pm.MembershipId)"
                                                                            disabled="@_actingMember">
                                                                        Aprobar
                                                                    </button>
                                                                    <button class="btn btn-xs btn-outline-danger rounded-2"
                                                                            @onclick="() => RejectMember(pgId, pm.MembershipId)"
                                                                            disabled="@_actingMember">
                                                                        Rechazar
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                @if (_memberList.Count == 0)
                                                {
                                                    <p class="text-muted small mb-0 py-2">Sin miembros activos.</p>
                                                }
                                                else
                                                {
                                                    <div class="rounded-3 overflow-hidden border" style="max-height:300px;overflow-y:auto;">
                                                        @foreach (var m in _memberList)
                                                        {
                                                            var am = m;
                                                            var agId = group.Id;
                                                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-white">
                                                                <div>
                                                                    <div class="fw-semibold small">@am.DisplayLabel</div>
                                                                    <div class="text-muted" style="font-size:.7rem;">@am.Email</div>
                                                                    @if (am.JoinedAt.HasValue)
                                                                    {
                                                                        <div class="text-muted" style="font-size:.65rem;">
                                                                            Miembro desde @am.JoinedAt.Value.ToString("dd MMM yyyy")
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <button class="btn btn-xs btn-outline-danger rounded-2 flex-shrink-0"
                                                                        @onclick="() => RemoveMember(agId, am.UserId)"
                                                                        disabled="@_actingMember">
                                                                    Eliminar
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-center gap-2">
                    @for (int p = 1; p <= Math.Min(_totalPages, 10); p++)
                    {
                        var pageNum = p;
                        <button class="btn btn-sm @(_page == pageNum ? "btn-uerre-primary" : "btn-uerre-outline") rounded-2"
                                type="button" @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private List<GroupModel> _groups = [];
    private bool _loading = true, _acting;
    private string _search = "", _statusFilter = "";
    private int _page = 1, _totalPages = 1;
    private CancellationTokenSource? _debounce;

    // Member management panel state
    private Guid? _expandedGroupId;
    private string _memberTab = "pending";
    private List<MembershipModel> _pendingList = [];
    private List<GroupMemberModel> _memberList = [];
    private bool _memberLoading;
    private bool _actingMember;
    private bool _showSeasonReset;
    private bool _seasonGroupsLoading;
    private bool _resettingSeason;
    private List<GroupModel> _seasonGroups = [];
    private HashSet<Guid> _seasonSkipGroupIds = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var result = await AdminService.GetAllGroupsAdminAsync(
                search: _search.Length > 0 ? _search : null,
                status: _statusFilter.Length > 0 ? _statusFilter : null,
                page: _page);
            _groups     = result?.Data ?? [];
            _totalPages = result?.TotalPages ?? 1;
        }
        catch { _groups = []; }
        finally { _loading = false; }
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel(); _debounce = new CancellationTokenSource();
        try { await Task.Delay(350, _debounce.Token); _page = 1; await LoadAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task OnStatusFilter(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        _page = 1; await LoadAsync();
    }

    private async Task SetStatus(Guid groupId, string newStatus)
    {
        _acting = true;
        try
        {
            await AdminService.SetGroupStatusAsync(groupId, newStatus);
            // Close panel if it was open for this group
            if (_expandedGroupId == groupId) _expandedGroupId = null;
            await LoadAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private Task Activate(Guid id)   => SetStatus(id, "active");
    private Task Deactivate(Guid id) => SetStatus(id, "inactive");
    private Task Reject(Guid id)     => SetStatus(id, "rejected");

    private async Task GoToPage(int page) { _page = page; await LoadAsync(); }

    private async Task ToggleSeasonReset()
    {
        _showSeasonReset = !_showSeasonReset;
        if (!_showSeasonReset) return;

        _seasonGroupsLoading = true;
        try
        {
            _seasonGroups = await AdminService.GetActiveGroupsForSeasonResetAsync();
            _seasonSkipGroupIds = [];
        }
        finally
        {
            _seasonGroupsLoading = false;
        }
    }

    private void ToggleSeasonGroup(Guid groupId, bool include)
    {
        if (include) _seasonSkipGroupIds.Remove(groupId);
        else _seasonSkipGroupIds.Add(groupId);
    }

    private async Task ConfirmSeasonReset()
    {
        _resettingSeason = true;
        try
        {
            await AdminService.ResetSeasonAsync(_seasonSkipGroupIds);
            _showSeasonReset = false;
            _expandedGroupId = null;
            await LoadAsync();
        }
        finally
        {
            _resettingSeason = false;
        }
    }

    private async Task ResetGroupSeason(Guid groupId)
    {
        _resettingSeason = true;
        try
        {
            await AdminService.ResetGroupSeasonAsync(groupId);
            if (_expandedGroupId == groupId) _expandedGroupId = null;
            await LoadAsync();
        }
        finally
        {
            _resettingSeason = false;
        }
    }

    // ── Member panel ──────────────────────────────────────────────────────────

    private async Task ToggleMembersPanel(Guid groupId)
    {
        if (_expandedGroupId == groupId)
        {
            _expandedGroupId = null;
            return;
        }
        _expandedGroupId = groupId;
        _memberTab = "pending";
        await LoadMembersAsync(groupId);
    }

    private async Task LoadMembersAsync(Guid groupId)
    {
        _memberLoading = true;
        StateHasChanged();
        try
        {
            _pendingList = await GroupService.GetPendingMembershipsAsync(groupId);
            _memberList  = await GroupService.GetMembersAsync(groupId);
        }
        catch
        {
            _pendingList = [];
            _memberList  = [];
        }
        finally
        {
            _memberLoading = false;
        }
    }

    private async Task ApproveMember(Guid groupId, Guid membershipId)
    {
        _actingMember = true;
        try
        {
            var result = await GroupService.ApproveMembershipAsync(groupId, membershipId);
            if (result is not null)
                await LoadMembersAsync(groupId);
        }
        finally
        {
            _actingMember = false;
        }
    }

    private async Task RejectMember(Guid groupId, Guid membershipId)
    {
        _actingMember = true;
        try
        {
            var result = await GroupService.RejectMembershipAsync(groupId, membershipId);
            if (result is not null)
                await LoadMembersAsync(groupId);
        }
        finally
        {
            _actingMember = false;
        }
    }

    private async Task RemoveMember(Guid groupId, Guid userId)
    {
        _actingMember = true;
        try
        {
            await GroupService.RemoveMemberAsync(groupId, userId);
            await LoadMembersAsync(groupId);
        }
        finally
        {
            _actingMember = false;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string StatusLabel(string status) => status switch
    {
        "active"   => "Activo",
        "pending"  => "Pendiente",
        "inactive" => "Inactivo",
        "rejected" => "Rechazado",
        _          => status
    };

    private static string StatusCss(string status) => status switch
    {
        "active"   => "bg-success-subtle text-success",
        "pending"  => "bg-warning-subtle text-warning",
        "inactive" => "bg-secondary-subtle text-secondary",
        "rejected" => "bg-danger-subtle text-danger",
        _          => "bg-secondary-subtle text-secondary"
    };
}
