@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminApiService AdminService
@inject IJSRuntime JS
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Gestionar Usuarios — Admin</PageTitle>

<div class="page-header">
    <div class="container-uerre">
        <a href="/admin" class="page-hero-link text-decoration-none small mb-2 d-inline-block">
            &larr; Panel Admin
        </a>
        <h1 class="page-hero-title fw-bold mb-1">
            Gestionar Usuarios
        </h1>
        <p class="page-hero-subtitle mb-0">
            Busca, filtra y administra las cuentas de la plataforma.
        </p>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre">

        <div class="d-flex flex-wrap gap-3 mb-4">
            <div class="search-input-wrapper" style="flex:1;min-width:220px;max-width:360px;">
                <span class="search-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15M3.5 10a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0m15.584 5.17 3.123 3.123a.75.75 0 0 1-1.06 1.06l-3.123-3.122a8 8 0 0 0 1.06-1.061"/></svg></span>
                <input type="search" class="form-control rounded-3"
                       placeholder="Buscar por email o nombre..."
                       value="@_search" @oninput="OnSearch" />
            </div>
            <select class="form-select rounded-3" style="max-width:180px;" @onchange="OnRoleFilter">
                <option value="">Todos los roles</option>
                <option value="student">Estudiante</option>
                <option value="group_leader">Líder de Grupo</option>
                <option value="admin">Administrador</option>
            </select>
        </div>

        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <div class="alert alert-warning rounded-3 border-0 mb-4">@_actionError</div>
        }

        @if (_loading)
        {
            <div class="d-flex justify-content-center py-5"><div class="spinner-uerre"></div></div>
        }
        else if (_users.Count == 0)
        {
            <p class="text-center text-muted py-4">No se encontraron usuarios.</p>
        }
        else
        {
            <div class="card-uerre overflow-hidden mb-4">
                <div class="table-responsive mobile-admin-table">
                <table class="table table-uerre mb-0">
                    <thead>
                        <tr>
                            <th class="py-3 px-4">Usuario</th>
                            <th class="py-3 px-4">Rol</th>
                            <th class="py-3 px-4">Estado</th>
                            <th class="py-3 px-4 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td class="py-3 px-4 align-middle">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt=""
                                                 class="rounded-circle flex-shrink-0"
                                                 style="width:32px;height:32px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                                 style="width:32px;height:32px;background:linear-gradient(135deg,var(--uerre-purple),var(--uerre-purple-vivid));font-size:.7rem;">
                                                @user.Initial
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold small text-dark">@user.DisplayLabel</div>
                                            <div class="text-muted" style="font-size:.7rem;">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4 align-middle">
                                    <span class="rounded-pill px-2 py-1 small fw-600"
                                          style="font-size:.7rem;@RoleCss(user.Role)">
                                        @RoleLabel(user.Role)
                                    </span>
                                </td>
                                <td class="py-3 px-4 align-middle">
                                    <span class="badge rounded-pill @(user.Status == "active" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")"
                                          style="font-size:.7rem;">
                                        @(user.Status == "active" ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="py-3 px-4 align-middle text-end">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap mobile-action-group">
                                        <!-- Role promotion -->
                                        @if (user.Role == "student")
                                        {
                                            <button class="btn btn-xs btn-uerre-outline rounded-2"
                                                    @onclick="() => StartPromoteToLeader(user.Id)"
                                                    disabled="@_acting"
                                                    title="Promover a Líder de Grupo">
                                                &rarr; Líder
                                            </button>
                                        }
                                        @if (user.Role != "admin")
                                        {
                                            <button class="btn btn-xs rounded-2"
                                                    style="background:var(--uerre-navy);color:#fff;border:none;"
                                                    @onclick="() => PromoteToAdmin(user.Id)"
                                                    disabled="@_acting"
                                                    title="Promover a Administrador">
                                                &rarr; Admin
                                            </button>
                                        }
                                        @if (user.Role == "group_leader" || user.Role == "admin")
                                        {
                                            <button class="btn btn-xs btn-outline-secondary rounded-2"
                                                    @onclick="() => DemoteToStudent(user.Id)"
                                                    disabled="@_acting"
                                                    title="Quitar liderazgo y volver a Estudiante">
                                                @(user.Role == "group_leader" ? "Quitar líder" : "Estudiante")
                                            </button>
                                        }
                                        <!-- Status toggle -->
                                        @if (user.Status == "active")
                                        {
                                            <button class="btn btn-xs btn-outline-danger rounded-2"
                                                    @onclick="() => Deactivate(user.Id)"
                                                    disabled="@_acting">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-xs btn-outline-success rounded-2"
                                                    @onclick="() => Activate(user.Id)"
                                                    disabled="@_acting">
                                                Activar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>

                            @if (_leaderAssignmentUserId == user.Id)
                            {
                                <tr style="background:var(--uerre-surface,#f8f9fa);">
                                    <td colspan="4" class="py-3 px-4 border-top-0">
                                        <div class="d-flex flex-column flex-md-row align-items-md-end gap-3">
                                            <div class="flex-grow-1">
                                                <label class="form-label fw-semibold small mb-1">Selecciona el grupo para asignar liderazgo</label>
                                                <select class="form-select rounded-3"
                                                        @bind="_selectedLeaderGroupId"
                                                        disabled="@_acting">
                                                    <option value="">Selecciona un grupo activo...</option>
                                                    @foreach (var group in _leaderGroups)
                                                    {
                                                        <option value="@group.Id">@group.Name</option>
                                                    }
                                                </select>
                                                <div class="form-text">Si el grupo ya tiene líder, la asignación se bloquea hasta quitarlo.</div>
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap mobile-action-group">
                                                <button class="btn btn-sm btn-uerre-primary rounded-2"
                                                        @onclick="() => ConfirmPromoteToLeader(user.Id)"
                                                        disabled="@_acting || string.IsNullOrWhiteSpace(_selectedLeaderGroupId)">
                                                    Asignar liderazgo
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary rounded-2"
                                                        @onclick="CancelPromoteToLeader"
                                                        disabled="@_acting">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            </div>

            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-center gap-2 mt-4">
                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pageNum = p;
                        <button class="btn btn-sm @(_page == pageNum ? "btn-uerre-primary" : "btn-uerre-outline") rounded-2"
                                type="button" @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private List<UserModel> _users = [];
    private List<GroupModel> _leaderGroups = [];
    private bool _loading = true, _acting;
    private string _search = "", _roleFilter = "";
    private string? _actionError;
    private Guid? _leaderAssignmentUserId;
    private string _selectedLeaderGroupId = "";
    private int _page = 1, _totalPages = 1;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderGroupsAsync();
        await LoadAsync();
    }

    private async Task LoadLeaderGroupsAsync()
    {
        try { _leaderGroups = await AdminService.GetActiveGroupsForSeasonResetAsync(); }
        catch { _leaderGroups = []; }
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var result = await AdminService.GetUsersAsync(
                search: _search.Length > 0 ? _search : null,
                role: _roleFilter.Length > 0 ? _roleFilter : null,
                page: _page);
            _users      = result?.Data ?? [];
            _totalPages = result?.TotalPages ?? 1;
        }
        catch { _users = []; }
        finally { _loading = false; }
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel(); _debounce = new CancellationTokenSource();
        try { await Task.Delay(350, _debounce.Token); _page = 1; await LoadAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task OnRoleFilter(ChangeEventArgs e)
    {
        _roleFilter = e.Value?.ToString() ?? ""; _page = 1; await LoadAsync();
    }

    private async Task SetRole(Guid id, string role)
    {
        _acting = true;
        _actionError = null;
        try
        {
            await AdminService.SetRoleAsync(id, role);
            CancelPromoteToLeader();
            await LoadLeaderGroupsAsync();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _acting = false;
        }
    }

    private Task PromoteToAdmin(Guid id)  => SetRole(id, "admin");
    private Task DemoteToStudent(Guid id) => SetRole(id, "student");

    private void StartPromoteToLeader(Guid id)
    {
        _actionError = null;
        _leaderAssignmentUserId = id;
        _selectedLeaderGroupId = "";
    }

    private void CancelPromoteToLeader()
    {
        _leaderAssignmentUserId = null;
        _selectedLeaderGroupId = "";
    }

    private async Task ConfirmPromoteToLeader(Guid id)
    {
        if (!Guid.TryParse(_selectedLeaderGroupId, out var groupId))
        {
            _actionError = "Debes seleccionar un grupo para asignar liderazgo.";
            return;
        }

        _acting = true;
        _actionError = null;
        try
        {
            await AdminService.SetRoleAsync(id, "group_leader", groupId);
            CancelPromoteToLeader();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _actionError = ex.Message;
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task Deactivate(Guid id)
    {
        _acting = true;
        _actionError = null;
        try
        {
            await AdminService.SetStatusAsync(id, "inactive");
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task Activate(Guid id)
    {
        _acting = true;
        _actionError = null;
        try
        {
            await AdminService.SetStatusAsync(id, "active");
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task GoToPage(int page) { _page = page; await LoadAsync(); }

    private static string RoleLabel(string role) => role switch
    {
        "admin"        => "Administrador",
        "group_leader" => "Líder de Grupo",
        _              => "Estudiante"
    };

    private static string RoleCss(string role) => role switch
    {
        "admin"        => "background:var(--uerre-navy);color:#fff;",
        "group_leader" => "background:var(--uerre-tag-bg);color:var(--uerre-purple);",
        _              => "background:#f3f4f6;color:#6b7280;"
    };
}
