@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminApiService AdminService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Panel de Administración — Student Groups Hub</PageTitle>

<div class="page-header">
    <div class="container-uerre">
        <h1 class="text-white fw-bold mb-1" style="font-size:clamp(1.5rem,4vw,2.25rem);">
            Panel de Administración
        </h1>
        <p class="mb-0" style="color:rgba(255,255,255,.7);">
            Gestión de usuarios, grupos y actividad de la plataforma.
        </p>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre">

        @if (_loading)
        {
            <div class="row g-4 mb-5">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="stat-card"><div class="skeleton" style="height:60px;"></div></div>
                    </div>
                }
            </div>
        }
        else if (_stats is not null)
        {
            <!-- KPI cards -->
            <div class="row g-4 mb-5">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center">
                        <div class="stat-number">@_stats.TotalUsers</div>
                        <div class="stat-name">Usuarios</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center">
                        <div class="stat-number">@_stats.ActiveGroups</div>
                        <div class="stat-name">Grupos Activos</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center"
                         style="@(PendingRequests > 0 ? "border-color:var(--uerre-gold);" : "")">
                        <div class="stat-number"
                             style="color:@(PendingRequests > 0 ? "var(--uerre-gold)" : "var(--uerre-purple)");">
                            @PendingRequests
                        </div>
                        <div class="stat-name">Solicitudes</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center">
                        <div class="stat-number">@_stats.TotalEvents</div>
                        <div class="stat-name">Eventos</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center">
                        <div class="stat-number">@_stats.TotalMemberships</div>
                        <div class="stat-name">Membresías</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="stat-card text-center">
                        <div class="stat-number">@_stats.TotalGroups</div>
                        <div class="stat-name">Total Grupos</div>
                    </div>
                </div>
            </div>
        }

        <!-- Navigation cards -->
        <h5 class="fw-bold mb-4">Módulos de Administración</h5>
        <div class="row g-4">

            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/admin/users" class="text-decoration-none d-block h-100">
                    <div class="card-uerre h-100 p-4 d-flex align-items-start gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                             style="width:52px;height:52px;background:linear-gradient(135deg,var(--uerre-purple),var(--uerre-purple-vivid));font-size:1.25rem;">
                            U
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Gestionar Usuarios</h6>
                            <p class="text-muted small mb-0">
                                Buscar, filtrar, cambiar roles y activar/desactivar cuentas.
                            </p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/admin/groups" class="text-decoration-none d-block h-100">
                    <div class="card-uerre h-100 p-4 d-flex align-items-start gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                             style="width:52px;height:52px;background:linear-gradient(135deg,#0ea5e9,#2563eb);font-size:1.25rem;">
                            G
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Gestionar Grupos</h6>
                            <p class="text-muted small mb-0">
                                Ver todos los grupos, activar, desactivar y revisar detalles.
                            </p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/admin/requests" class="text-decoration-none d-block h-100">
                    <div class="card-uerre h-100 p-4 d-flex align-items-start gap-3"
                         style="@(PendingRequests > 0 ? "border-color:var(--uerre-gold);" : "")">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                             style="width:52px;height:52px;background:linear-gradient(135deg,#f59e0b,#d97706);font-size:1.25rem;">
                            S
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold mb-1">Solicitudes</h6>
                                @if (PendingRequests > 0)
                                {
                                    <span class="badge rounded-pill text-white mb-1"
                                          style="background:var(--uerre-gold);font-size:.65rem;">
                                        @PendingRequests pendiente@(PendingRequests != 1 ? "s" : "")
                                    </span>
                                }
                            </div>
                            <p class="text-muted small mb-0">
                                Aprobar o rechazar solicitudes de grupos y liderazgo.
                            </p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/timeline" class="text-decoration-none d-block h-100">
                    <div class="card-uerre h-100 p-4 d-flex align-items-start gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                             style="width:52px;height:52px;background:linear-gradient(135deg,#10b981,#0d9488);font-size:1.25rem;">
                            H
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Historial de Administraciones</h6>
                            <p class="text-muted small mb-0">
                                Ver y registrar administraciones y miembros de todos los grupos.
                            </p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <a href="/feur" class="text-decoration-none d-block h-100">
                    <div class="card-uerre h-100 p-4 d-flex align-items-start gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                             style="width:52px;height:52px;background:linear-gradient(135deg,#a855f7,#7c3aed);font-size:1.25rem;">
                            F
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">FEUR</h6>
                            <p class="text-muted small mb-0">
                                Gestionar la Federación de Estudiantes U-ERRE y sus administraciones.
                            </p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>

@code {
    private DashboardAdminModel? _stats;
    private bool _loading = true;
    private int PendingRequests => (_stats?.PendingGroupRequests ?? 0) + (_stats?.PendingLeadershipRequests ?? 0);

    protected override async Task OnInitializedAsync()
    {
        try { _stats = await AdminService.GetMetricsAsync(); }
        catch { _stats = null; }
        finally { _loading = false; }
    }
}
