@page "/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject DashboardApiService DashboardService
@inject UserApiService UserService
@inject NotificationApiService NotificationService
@inject GroupRegistrationApiService RegistrationService
@attribute [Authorize]

<PageTitle>Mi Panel — Student Groups Hub</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:50vh;">
        <div class="spinner-uerre"></div>
    </div>
}
else
{
    <!-- Header -->
    <section class="hero-gradient py-4 text-white">
        <div class="container" style="max-width:1200px;">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width:56px;height:56px;background:rgba(255,255,255,.2);font-size:1.25rem;">
                        @_user?.Initial
                    </div>
                    <div>
                        <h1 class="fw-bold mb-0 text-white" style="font-family:'Montserrat',sans-serif;font-size:1.5rem;">
                            @(_user?.DisplayLabel ?? "Usuario")
                        </h1>
                        <p class="mb-0 small" style="color:rgba(255,255,255,.6);">@_user?.Email</p>
                        <span class="rounded-pill px-2 py-1 mt-1 d-inline-block"
                              style="background:rgba(255,255,255,.15);font-size:.7rem;font-weight:600;">
                            @RoleLabel
                        </span>
                    </div>
                </div>
                <a href="MicrosoftIdentity/Account/SignOut"
                   class="btn btn-sm" style="color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.2);">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container" style="max-width:1200px;">

            @if (_error is not null)
            {
                <div class="alert alert-danger rounded-3 mb-4">@_error</div>
            }

            @if (_user?.IsAdmin == true)
            {
                <AdminDashboardView Data="_adminData" />
            }
            else if (_user?.IsGroupLeader == true)
            {
                <LeaderDashboardView Data="_leaderData" Notifications="_notifications"
                                     OnMarkAllRead="MarkAllRead" OnMarkRead="MarkRead"
                                     UnreadCount="_unreadCount" MarkingAll="_markingAll" />
            }
            else
            {
                <StudentDashboardView Data="_studentData" Notifications="_notifications"
                                      Requests="_requests"
                                      OnMarkAllRead="MarkAllRead" OnMarkRead="MarkRead"
                                      UnreadCount="_unreadCount" MarkingAll="_markingAll" />
            }

        </div>
    </section>
}

@code {
    private UserModel? _user;
    private DashboardStudentModel? _studentData;
    private DashboardLeaderModel?  _leaderData;
    private DashboardAdminModel?   _adminData;
    private List<NotificationModel> _notifications = [];
    private List<GroupRegistrationRequestModel> _requests = [];
    private bool _loading = true, _markingAll;
    private string? _error;
    private int _unreadCount => _notifications.Count(n => !n.Read);
    private string RoleLabel => _user?.Role switch
    {
        "admin"        => "Administrador",
        "group_leader" => "Líder de Grupo",
        _              => "Estudiante"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = await UserService.GetMeAsync();
            if (_user is null) return;

            var notifTask = NotificationService.GetMineAsync();

            if (_user.IsAdmin)
            {
                var adminTask = DashboardService.GetAdminAsync();
                await Task.WhenAll(notifTask, adminTask);
                _adminData     = adminTask.Result;
                _notifications = notifTask.Result ?? [];
            }
            else if (_user.IsGroupLeader)
            {
                var leaderTask = DashboardService.GetLeaderAsync();
                await Task.WhenAll(notifTask, leaderTask);
                _leaderData    = leaderTask.Result;
                _notifications = notifTask.Result ?? [];
            }
            else
            {
                var studentTask = DashboardService.GetStudentAsync();
                var reqTask     = RegistrationService.GetMineAsync();
                await Task.WhenAll(notifTask, studentTask, reqTask);
                _studentData   = studentTask.Result;
                _requests      = reqTask.Result ?? [];
                _notifications = notifTask.Result ?? [];
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task MarkAllRead()
    {
        _markingAll = true;
        await NotificationService.MarkAllReadAsync();
        _notifications = _notifications.Select(n => n with { Read = true }).ToList();
        _markingAll = false;
    }

    private async Task MarkRead(Guid id)
    {
        await NotificationService.MarkReadAsync(id);
        _notifications = _notifications.Select(n => n.Id == id ? n with { Read = true } : n).ToList();
    }
}
