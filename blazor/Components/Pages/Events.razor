@page "/events"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject EventApiService EventService
@attribute [Authorize]

<PageTitle>Eventos — Grupos Estudiantiles</PageTitle>

<div class="page-header">
    <div class="container-uerre">
        <h1 class="page-hero-title fw-bold mb-1">Próximos Eventos</h1>
        <p class="page-hero-subtitle mb-4">Hackathons, conciertos, talleres y más en U-ERRE.</p>
        <div class="search-input-wrapper" style="max-width:440px;">
            <span class="search-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15M3.5 10a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0m15.584 5.17 3.123 3.123a.75.75 0 0 1-1.06 1.06l-3.123-3.122a8 8 0 0 0 1.06-1.061"/></svg></span>
            <input type="search" class="form-control rounded-pill py-2"
                   style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;padding-left:2.5rem !important;"
                   placeholder="Buscar eventos..."
                   value="@_search" @oninput="OnSearch" />
        </div>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre">
        @if (_loading)
        {
            <div class="row g-4">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="col-12 col-md-6">
                        <div class="card-uerre no-hover p-4 d-flex gap-3">
                            <div class="skeleton flex-shrink-0" style="width:60px;height:60px;border-radius:12px;"></div>
                            <div class="flex-grow-1">
                                <div class="skeleton mb-2" style="height:14px;width:65%;"></div>
                                <div class="skeleton mb-3" style="height:11px;width:40%;"></div>
                                <div class="d-flex gap-3">
                                    <div class="skeleton" style="height:11px;width:25%;"></div>
                                    <div class="skeleton" style="height:11px;width:30%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_events.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3A3.25 3.25 0 0 1 21 6.25v11.5A3.25 3.25 0 0 1 17.75 21H6.25A3.25 3.25 0 0 1 3 17.75V6.25A3.25 3.25 0 0 1 6.25 3zM19.5 8.5h-15v9.25c0 .966.784 1.75 1.75 1.75h11.5a1.75 1.75 0 0 0 1.75-1.75zm-11.75 6a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m-4.25-4a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m1-6h-11.5A1.75 1.75 0 0 0 4.5 6.25V7h15v-.75a1.75 1.75 0 0 0-1.75-1.75"/></svg></div>
                <h5 class="fw-bold mb-1">No hay eventos próximos</h5>
                <p class="text-muted small">
                    @(_search.Length > 0 ? "No se encontraron eventos con ese nombre." : "Los grupos aún no han publicado eventos.")
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var evt in _events)
                {
                    <div class="col-12 col-md-6">
                        <EventCard Event="@evt" />
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<EventModel> _events = [];
    private bool _loading = true;
    private string _search = "";
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try { _events = await EventService.GetUpcomingAsync(_search.Length > 0 ? _search : null); }
        catch { _events = []; }
        finally { _loading = false; }
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel(); _debounce = new CancellationTokenSource();
        try { await Task.Delay(350, _debounce.Token); await LoadAsync(); }
        catch (TaskCanceledException) { }
    }
}
