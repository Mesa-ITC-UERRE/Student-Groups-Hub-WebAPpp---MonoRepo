@page "/events/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject EventApiService EventService
@inject EventPostApiService EventPostService
@inject CurrentUserService CurrentUser
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

<PageTitle>@(_event?.Title ?? "Evento") — Grupos Estudiantiles</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:50vh;">
        <div class="spinner-uerre"></div>
    </div>
}
else if (_event is null)
{
    <div class="container py-5"><div class="alert alert-danger rounded-3">Evento no encontrado.</div></div>
}
else
{
    var eventHeroStyle = !string.IsNullOrWhiteSpace(_event.BannerUrl)
        ? $"background-image:linear-gradient(rgba(76,29,149,.1),rgba(124,58,237,.2)),url({_event.BannerUrl});background-size:cover;background-position:center;"
        : "";

    <section class="hero-gradient event-detail-hero py-4 py-md-5 text-white @(!string.IsNullOrWhiteSpace(_event.BannerUrl) ? "event-detail-hero--banner" : "")"
             style="@eventHeroStyle">
        <div class="container-uerre">
            <a href="/events" class="btn btn-sm nav-arrow-pill mb-3 px-3">
                <FluentIcon Name="chevron-left" Size="14" />
                <span>Todos los eventos</span>
            </a>
            <div class="event-hero-layout d-flex flex-column flex-lg-row align-items-stretch align-items-lg-end gap-3">
                <div class="event-hero-identity d-flex align-items-start gap-3 @(!string.IsNullOrWhiteSpace(_event.BannerUrl) ? "event-hero-identity--banner" : "")">
                    <div class="event-date-badge flex-shrink-0">
                        <span class="event-date-month">@_event.MonthLabel</span>
                        <span class="event-date-day">@_event.DayLabel</span>
                    </div>
                    <div class="event-hero-copy flex-grow-1 min-w-0">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h1 class="fw-bold text-white mb-0">@_event.Title</h1>
                            @if (_event.IsCanceled)
                            {
                                <span class="badge bg-secondary">Cancelado</span>
                            }
                        </div>
                        <p class="event-hero-group fw-semibold mb-2">@_event.GroupName</p>
                        <div class="event-hero-meta d-flex flex-wrap gap-3 mb-3">
                            <span class="d-inline-flex align-items-center gap-1"><FluentIcon Name="clock" Size="14" /> @_event.StartLocal</span>
                            @if (_event.Location is not null)
                            {
                                <span class="d-inline-flex align-items-center gap-1"><FluentIcon Name="location" Size="14" /> @_event.Location</span>
                            }
                            <span class="d-inline-flex align-items-center gap-1"><FluentIcon Name="people" Size="14" /> @_event.AttendanceSummary</span>
                        </div>
                        @if (_event.Description is not null)
                        {
                            <p class="event-hero-description mb-0">@_event.Description</p>
                        }
                    </div>
                </div>
                <div class="flex-shrink-0 d-flex flex-column align-items-stretch gap-2 event-hero-actions">
                    @if (_canManage)
                    {
                        <button type="button" class="btn btn-hero" @onclick="OpenEditEvent">
                            Editar evento
                        </button>
                    }
                    <RsvpButton EventId="_event.Id" IsCanceled="_event.IsCanceled" HasCapacity="_event.HasCapacity" />
                </div>
            </div>
        </div>
    </section>

    @if (_editSuccess is not null)
    {
        <div class="container-uerre pt-3">
            <div class="alert alert-success rounded-3 mb-0" role="status">@_editSuccess</div>
        </div>
    }

    <section class="py-4 py-md-5" style="background:var(--uerre-surface);">
        <div class="container-uerre">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
                <div>
                    <h5 class="fw-bold mb-1">Evidencia del evento</h5>
                    <p class="text-muted small mb-0">Comparte fotos y resultados de cómo salió el evento.</p>
                </div>
            </div>

            @if (!_evidenceUnlocked)
            {
                <div class="alert rounded-3 border-0 mb-4" style="background:#ede9fe;color:#5b21b6;">
                    La evidencia del evento se habilita cuando el evento termina o si fue cancelado.
                </div>
            }

            @if (_canPostEvidence)
            {
                <div class="card-uerre p-4 mb-4">
                    <h6 class="fw-bold mb-3 small">Nueva actualización</h6>

                    @if (_postError is not null)
                    {
                        <div class="alert alert-danger rounded-3 small py-2 mb-3">@_postError</div>
                    }

                    <textarea class="form-control rounded-3 mb-3"
                              rows="3"
                              placeholder="Comparte cómo resultó el evento, aprendizajes o agradecimientos..."
                              @bind="_newPostBody"
                              maxlength="2000"></textarea>

                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <label for="eventEvidenceImageInput"
                               class="btn btn-uerre-outline btn-sm d-inline-flex align-items-center gap-1"
                               style="cursor:pointer;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3A3.25 3.25 0 0 1 21 6.25v11.5A3.25 3.25 0 0 1 17.75 21H6.25A3.25 3.25 0 0 1 3 17.75V6.25A3.25 3.25 0 0 1 6.25 3zM19.5 8.5h-15v9.25c0 .966.784 1.75 1.75 1.75h11.5a1.75 1.75 0 0 0 1.75-1.75zM9.5 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5m0 1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>
                            Adjuntar foto
                        </label>
                        <InputFile id="eventEvidenceImageInput"
                                   OnChange="OnPostImageSelected"
                                   accept="image/jpeg,image/png,image/webp,image/gif"
                                   style="display:none;" />

                        @if (_postImagePreview is not null)
                        {
                            <span class="small text-success d-inline-flex align-items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 1.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17m4.03 5.97-5.28 5.29-2.28-2.28a.75.75 0 1 0-1.06 1.06l2.81 2.81a.75.75 0 0 0 1.06 0l5.81-5.82a.75.75 0 0 0-1.06-1.06"/></svg> Imagen lista</span>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="RemovePostImage">Quitar</button>
                        }

                        <button class="btn btn-uerre-primary btn-sm ms-auto px-4"
                                @onclick="SubmitPost"
                                disabled="@_submittingPost">
                            @if (_submittingPost)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Publicar evidencia
                        </button>
                    </div>

                    @if (_postImagePreview is not null)
                    {
                        <img src="@_postImagePreview" alt="Preview"
                             class="mt-3 rounded-3"
                             style="max-height:220px;max-width:100%;object-fit:contain;" />
                    }
                </div>
            }

            @if (_galleryImages.Count > 0)
            {
                <div class="card-uerre p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
                        <div>
                            <h6 class="fw-bold mb-1">Galería</h6>
                            <p class="text-muted small mb-0">@_galleryImages.Count foto@(_galleryImages.Count == 1 ? "" : "s") del evento.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        @foreach (var imageUrl in _galleryImages)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <button class="border-0 bg-transparent p-0 w-100"
                                        type="button"
                                        @onclick="() => OpenGalleryImage(imageUrl)">
                                    <img src="@imageUrl" alt="Galería del evento"
                                         class="rounded-3 w-100"
                                         style="aspect-ratio:1/1;object-fit:cover;box-shadow:0 6px 18px rgba(15,23,42,.08);" />
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_posts.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.527 3.66 1.443 5.168L2.22 20.22a.75.75 0 0 0 .976.976l3.051-1.222A9.96 9.96 0 0 0 12 21c5.523 0 10-4.477 10-10S17.523 2 12 2m0 1.5a8.5 8.5 0 0 1 4.94 15.501l-.183.11-2.74 1.096.001-.003-2.034-.002A8.5 8.5 0 0 1 12 3.5"/></svg></div>
                    <h5 class="fw-bold mb-1">Sin evidencia todavía</h5>
                    <p class="text-muted small mb-0">Las fotos y actualizaciones del resultado del evento aparecerán aquí.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var post in _posts)
                    {
                        <div class="card-uerre no-hover p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(post.AuthorAvatarUrl))
                                {
                                    <img src="@post.AuthorAvatarUrl" alt="" class="rounded-circle flex-shrink-0" style="width:38px;height:38px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                                         style="width:38px;height:38px;background:var(--uerre-purple);font-size:.8rem;">
                                        @post.AuthorInitial
                                    </div>
                                }
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold small text-dark">@post.AuthorDisplayName</div>
                                    <div class="text-muted" style="font-size:.7rem;">@post.TimeAgo</div>
                                </div>
                                @if (_isAdmin || post.AuthorUserId == _currentUserId)
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0 flex-shrink-0"
                                            style="font-size:.7rem;"
                                            @onclick="() => DeletePost(post.Id)">
                                        Eliminar
                                    </button>
                                }
                            </div>

                            <p class="mb-0" style="white-space:pre-wrap;font-size:.9rem;">@post.Body</p>

                            @if (post.ImageUrl is not null)
                            {
                                <img src="@post.ImageUrl" alt="" class="mt-3 rounded-3 w-100" style="max-height:420px;object-fit:cover;" />
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (_showEditEvent)
    {
        <div class="modal-backdrop fade show" style="z-index:1040;" @onclick="CloseEditEvent"></div>
        <div class="modal fade show d-block event-edit-modal" tabindex="-1" style="z-index:1050;"
             role="dialog" aria-modal="true" aria-labelledby="event-edit-title">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <div>
                            <p class="section-label mb-2">Gestión de evento</p>
                            <h2 id="event-edit-title" class="modal-title h5 mb-0">Editar evento</h2>
                        </div>
                        <button type="button" class="btn-close" aria-label="Cerrar edición"
                                @onclick="CloseEditEvent" disabled="@_savingEdit"></button>
                    </div>
                    <div class="modal-body px-4">
                        @if (_editError is not null)
                        {
                            <div class="alert alert-danger rounded-3 small" role="alert">@_editError</div>
                        }

                        <div class="mb-3">
                            <label for="editEventTitle" class="form-label">Título</label>
                            <input id="editEventTitle" class="form-control" maxlength="200" @bind="_editTitle" />
                        </div>
                        <div class="mb-3">
                            <label for="editEventDescription" class="form-label">Descripción</label>
                            <textarea id="editEventDescription" class="form-control" rows="3" @bind="_editDescription"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="editEventLocation" class="form-label">Lugar</label>
                            <input id="editEventLocation" class="form-control" maxlength="300" @bind="_editLocation" />
                        </div>
                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <label class="form-label mb-0">Banner del evento</label>
                                <span class="text-muted" style="font-size:.7rem;">Opcional · máximo 5 MB</span>
                            </div>
                            @if (_editBannerPreview is not null)
                            {
                                <img src="@_editBannerPreview" alt="Vista previa del banner"
                                     class="event-banner-picker-preview mb-2" />
                            }
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label for="editEventBannerInput"
                                       class="btn btn-sm btn-uerre-outline d-inline-flex align-items-center gap-1"
                                       style="cursor:pointer;">
                                    <FluentIcon Name="image" Size="14" />
                                    @(_editBannerPreview is null ? "Elegir imagen" : "Cambiar imagen")
                                </label>
                                <InputFile id="editEventBannerInput"
                                           OnChange="OnEditBannerSelected"
                                           accept="image/jpeg,image/png,image/webp,image/gif"
                                           style="display:none;" />
                                @if (_editBannerPreview is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                            @onclick="RemoveEditBanner">
                                        Quitar
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <EventDateTimeInput Id="editEventStart"
                                                    Label="Inicio"
                                                    @bind-DateText="_editStartDate"
                                                    @bind-TimeText="_editStartTime" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <EventDateTimeInput Id="editEventEnd"
                                                    Label="Fin"
                                                    @bind-DateText="_editEndDate"
                                                    @bind-TimeText="_editEndTime" />
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label for="editEventCapacity" class="form-label">Capacidad</label>
                                <input id="editEventCapacity" type="number" class="form-control" min="1"
                                       placeholder="Sin límite" @bind="_editCapacity" />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label for="editEventVisibility" class="form-label">Visibilidad</label>
                                <select id="editEventVisibility" class="form-select" @bind="_editVisibility">
                                    <option value="public">Público</option>
                                    <option value="members">Solo miembros</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label for="editEventStatus" class="form-label">Estado</label>
                                <select id="editEventStatus" class="form-select" @bind="_editStatus">
                                    <option value="draft">Borrador</option>
                                    <option value="published">Publicado</option>
                                    <option value="canceled">Cancelado</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4 event-edit-actions">
                        <button type="button" class="btn btn-uerre-outline" @onclick="CloseEditEvent" disabled="@_savingEdit">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-uerre-primary" @onclick="SaveEventEdit" disabled="@_savingEdit">
                            @if (_savingEdit)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar cambios</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_selectedGalleryImage is not null)
    {
        <div class="modal-backdrop fade show" style="z-index:1040;" @onclick="CloseGalleryImage"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1050;" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content border-0 bg-transparent shadow-none">
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-light rounded-circle" style="width:40px;height:40px;" @onclick="CloseGalleryImage">×</button>
                    </div>
                    <img src="@_selectedGalleryImage" alt="Vista ampliada"
                         class="rounded-4 w-100"
                         style="max-height:80vh;object-fit:contain;background:#0f172a;" />
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EventModel? _event;
    private List<EventPostModel> _posts = [];
    private bool _loading = true;
    private bool _canPostEvidence;
    private bool _evidenceUnlocked;
    private bool _isAdmin;
    private bool _canManage;
    private Guid _currentUserId;
    private List<string> _galleryImages = [];
    private string? _selectedGalleryImage;

    private string _newPostBody = "";
    private byte[]? _postImageBytes;
    private string? _postImageContentType;
    private string? _postImageExt;
    private string? _postImagePreview;
    private bool _submittingPost;
    private string? _postError;

    private bool _showEditEvent;
    private string _editTitle = "";
    private string? _editDescription;
    private string? _editLocation;
    private string _editStartDate = "";
    private string _editStartTime = "";
    private string _editEndDate = "";
    private string _editEndTime = "";
    private int? _editCapacity;
    private string _editStatus = "published";
    private string _editVisibility = "public";
    private byte[]? _editBannerBytes;
    private string? _editBannerContentType;
    private string? _editBannerExt;
    private string? _editBannerPreview;
    private bool _removeEditBanner;
    private bool _savingEdit;
    private string? _editError;
    private string? _editSuccess;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _event = await EventService.GetByIdAsync(Id);
            if (_event is not null)
            {
                var postsTask = EventPostService.GetPostsAsync(Id);
                var canPostTask = EventPostService.CanPostAsync(Id);
                await Task.WhenAll(postsTask, canPostTask);
                _posts = postsTask.Result;
                _galleryImages = _posts.Where(p => !string.IsNullOrEmpty(p.ImageUrl)).Select(p => p.ImageUrl!).ToList();
                _canPostEvidence = canPostTask.Result;
                var currentUser = await CurrentUser.GetUserAsync();
                _currentUserId = currentUser?.Id ?? Guid.Empty;
                _isAdmin = currentUser?.Role == "admin";
                _canManage = await EventService.CanManageAsync(_event.GroupId);
                _evidenceUnlocked = _event.EndAt < DateTime.UtcNow || _event.IsCanceled;
            }
        }
        catch
        {
            _event = null;
            _posts = [];
            _galleryImages = [];
            _canPostEvidence = false;
            _evidenceUnlocked = false;
            _isAdmin = false;
            _canManage = false;
            _currentUserId = Guid.Empty;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPostImageSelected(InputFileChangeEventArgs e)
    {
        _postError = null;
        _postImagePreview = null;
        _postImageBytes = null;

        var file = e.File;
        if (!StorageService.AllowedMimeTypes.Contains(file.ContentType))
        {
            _postError = "Formato no permitido.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5L * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _postImageBytes = ms.ToArray();
        }
        catch (IOException)
        {
            _postError = "La imagen supera 5 MB.";
            return;
        }

        var rawExt = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
        _postImageExt = string.IsNullOrEmpty(rawExt) ? "jpg" : rawExt;
        _postImageContentType = file.ContentType;
        _postImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(_postImageBytes)}";
    }

    private void RemovePostImage()
    {
        _postImageBytes = null;
        _postImageContentType = null;
        _postImageExt = null;
        _postImagePreview = null;
    }

    private async Task SubmitPost()
    {
        if (_event is null) return;

        _submittingPost = true;
        _postError = null;
        try
        {
            var created = await EventPostService.CreatePostAsync(
                _event.Id,
                _newPostBody,
                _postImageBytes,
                _postImageContentType,
                _postImageExt);

            if (created is not null)
            {
                _posts.Insert(0, created);
                if (!string.IsNullOrEmpty(created.ImageUrl))
                    _galleryImages.Insert(0, created.ImageUrl);
                _newPostBody = "";
                RemovePostImage();
            }
        }
        catch (InvalidOperationException ex)
        {
            _postError = ex.Message;
        }
        catch
        {
            _postError = "Error inesperado al publicar evidencia del evento.";
        }
        finally
        {
            _submittingPost = false;
        }
    }

    private async Task DeletePost(Guid postId)
    {
        if (_event is null) return;
        var ok = await EventPostService.DeletePostAsync(_event.Id, postId);
        if (ok)
        {
            var removed = _posts.FirstOrDefault(p => p.Id == postId);
            _posts.RemoveAll(p => p.Id == postId);
            if (!string.IsNullOrEmpty(removed?.ImageUrl))
                _galleryImages.Remove(removed.ImageUrl);
        }
    }

    private void OpenGalleryImage(string imageUrl) => _selectedGalleryImage = imageUrl;

    private void CloseGalleryImage() => _selectedGalleryImage = null;

    private void OpenEditEvent()
    {
        if (_event is null || !_canManage) return;

        _editTitle = _event.Title;
        _editDescription = _event.Description;
        _editLocation = _event.Location;
        var localStart = _event.StartAt.ToLocalTime();
        var localEnd = _event.EndAt.ToLocalTime();
        _editStartDate = EventDateTimeInput.FormatDate(localStart);
        _editStartTime = EventDateTimeInput.FormatTime(localStart);
        _editEndDate = EventDateTimeInput.FormatDate(localEnd);
        _editEndTime = EventDateTimeInput.FormatTime(localEnd);
        _editCapacity = _event.Capacity;
        _editStatus = _event.Status;
        _editVisibility = _event.Visibility;
        ResetEditBanner();
        _editError = null;
        _editSuccess = null;
        _showEditEvent = true;
    }

    private void CloseEditEvent()
    {
        if (_savingEdit) return;
        _showEditEvent = false;
        _editError = null;
        ResetEditBanner();
    }

    private async Task OnEditBannerSelected(InputFileChangeEventArgs e)
    {
        _editError = null;
        ResetEditBanner();

        var file = e.File;
        if (!StorageService.AllowedMimeTypes.Contains(file.ContentType))
        {
            _editError = "Formato no permitido. Usa JPEG, PNG, WebP o GIF.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(StorageService.MaxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _editBannerBytes = ms.ToArray();
        }
        catch (IOException)
        {
            _editError = "La imagen supera el límite de 5 MB.";
            return;
        }

        var rawExt = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
        _editBannerExt = string.IsNullOrEmpty(rawExt) ? "jpg" : rawExt;
        _editBannerContentType = file.ContentType;
        _editBannerPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(_editBannerBytes)}";
    }

    private void RemoveEditBanner()
    {
        _editBannerBytes = null;
        _editBannerContentType = null;
        _editBannerExt = null;
        _editBannerPreview = null;
        _removeEditBanner = true;
    }

    private void ResetEditBanner()
    {
        _editBannerBytes = null;
        _editBannerContentType = null;
        _editBannerExt = null;
        _editBannerPreview = _event?.BannerUrl;
        _removeEditBanner = false;
    }

    private async Task SaveEventEdit()
    {
        if (_event is null || !_canManage) return;
        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            _editError = "El título es requerido.";
            return;
        }
        if (!EventDateTimeInput.TryParse(_editStartDate, _editStartTime, out var editStart))
        {
            _editError = "La fecha de inicio debe usar el formato DD/MM/YYYY y una hora válida.";
            return;
        }
        if (!EventDateTimeInput.TryParse(_editEndDate, _editEndTime, out var editEnd))
        {
            _editError = "La fecha de fin debe usar el formato DD/MM/YYYY y una hora válida.";
            return;
        }
        if (editEnd <= editStart)
        {
            _editError = "La fecha de fin debe ser posterior a la de inicio.";
            return;
        }
        if (_editCapacity is <= 0)
        {
            _editError = "La capacidad debe ser mayor que cero.";
            return;
        }

        _savingEdit = true;
        _editError = null;
        try
        {
            var updated = await EventService.UpdateEventAsync(
                _event.GroupId,
                _event.Id,
                new BlazorUpdateEventRequest(
                     _editTitle.Trim(),
                     string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim(),
                     string.IsNullOrWhiteSpace(_editLocation) ? null : _editLocation.Trim(),
                     editStart.ToUniversalTime(),
                     editEnd.ToUniversalTime(),
                     _editCapacity,
                     _editStatus,
                     _editVisibility),
                 _editBannerBytes,
                 _editBannerContentType,
                 _editBannerExt,
                 _removeEditBanner);

            if (updated is null)
            {
                _editError = "No se encontró el evento para actualizarlo.";
                return;
            }

            _event = updated;
            _evidenceUnlocked = updated.EndAt < DateTime.UtcNow || updated.IsCanceled;
            _showEditEvent = false;
            _editSuccess = "Los cambios del evento se guardaron correctamente.";
        }
        catch (InvalidOperationException ex)
        {
            _editError = ex.Message;
        }
        catch
        {
            _editError = "No se pudieron guardar los cambios. Inténtalo de nuevo.";
        }
        finally
        {
            _savingEdit = false;
        }
    }
}
