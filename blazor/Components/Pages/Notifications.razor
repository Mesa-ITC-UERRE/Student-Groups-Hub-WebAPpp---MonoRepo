@page "/notifications"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject NotificationApiService NotificationSvc
@inject NavigationManager Navigation
@inject ILogger<Notifications> Logger

<PageTitle>Notificaciones | Grupos Estudiantiles U-ERRE</PageTitle>

<div class="page-header">
    <div class="container-uerre">
        <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3">
            <div>
                <h1 class="page-hero-title fw-bold mb-1">Notificaciones</h1>
                <p class="page-hero-subtitle mb-0">Solicitudes de grupos, respuestas y recordatorios de tus eventos.</p>
            </div>
        @if (_unreadCount > 0)
        {
            <button type="button" class="btn btn-light fw-semibold rounded-pill px-4 flex-shrink-0"
                    style="color:var(--uerre-purple);" disabled="@_markingAll" @onclick="MarkAllReadAsync">
                Marcar todo como leído
            </button>
        }
        </div>
    </div>
</div>

<section class="py-4 py-md-5" style="background:var(--uerre-surface);">
    <div class="container-uerre notifications-page-content">
        @if (_loading)
        {
            <div class="card-uerre no-hover overflow-hidden">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <div class="skeleton flex-shrink-0 rounded-circle" style="width:40px;height:40px;"></div>
                        <div class="flex-grow-1">
                            <div class="skeleton mb-2" style="height:12px;width:55%;"></div>
                            <div class="skeleton" style="height:10px;width:80%;"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_loadFailed)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/></svg>
                </div>
                <h5 class="fw-bold mb-1">No pudimos cargar tus notificaciones</h5>
                <p class="text-muted small mb-0">Actualiza la página para intentarlo de nuevo.</p>
            </div>
        }
        else if (_notifications.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/></svg>
                </div>
                <h5 class="fw-bold mb-1">No tienes notificaciones</h5>
                <p class="text-muted small mb-0">Las solicitudes y recordatorios aparecerán aquí.</p>
            </div>
        }
        else
        {
            <section class="card-uerre no-hover overflow-hidden" aria-label="Todas las notificaciones">
                @foreach (var notification in _notifications)
                {
                    <button type="button"
                            class="notification-feed-item @(!notification.Read ? "notification-feed-item-unread" : "")"
                            @onclick="() => OpenNotificationAsync(notification)">
                        <span class="notification-kind-icon @KindClass(notification.Kind)" aria-hidden="true">
                            @if (notification.Kind == "event_today")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="currentColor" viewBox="0 0 16 16"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h.5A1.5 1.5 0 0 1 15 2.5v12a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 14.5v-12A1.5 1.5 0 0 1 2.5 1H3V.5a.5.5 0 0 1 .5-.5M2 4v10.5a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5V4z"/></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/></svg>
                            }
                        </span>
                        <span class="notification-feed-copy">
                            <strong>@notification.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(notification.Body))
                            {
                                <span>@notification.Body</span>
                            }
                            <time datetime="@notification.CreatedAt.ToString("O")">@RelativeTime(notification.CreatedAt)</time>
                        </span>
                        @if (!notification.Read)
                        {
                            <span class="notification-unread-dot" aria-label="Sin leer"></span>
                        }
                    </button>
                }
            </section>
        }
    </div>
</section>

@code {
    private List<NotificationModel> _notifications = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _markingAll;
    private int _unreadCount => _notifications.Count(n => !n.Read);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _notifications = await NotificationSvc.GetMineAsync();
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Logger.LogWarning(ex, "Could not load the notifications page.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenNotificationAsync(NotificationModel notification)
    {
        if (!notification.Read)
        {
            await NotificationSvc.MarkReadAsync(notification.Id);
            var index = _notifications.FindIndex(n => n.Id == notification.Id);
            if (index >= 0) _notifications[index] = notification with { Read = true };
        }

        if (!string.IsNullOrWhiteSpace(notification.Href))
            Navigation.NavigateTo(notification.Href);
    }

    private async Task MarkAllReadAsync()
    {
        _markingAll = true;
        try
        {
            await NotificationSvc.MarkAllReadAsync();
            _notifications = _notifications.Select(n => n with { Read = true }).ToList();
        }
        finally
        {
            _markingAll = false;
        }
    }

    private static string KindClass(string kind) => kind switch
    {
        "event_today" => "notification-kind-event",
        "new_membership_request" => "notification-kind-request",
        "membership_approved" => "notification-kind-approved",
        "membership_rejected" => "notification-kind-rejected",
        _ => "notification-kind-default",
    };

    private static string RelativeTime(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt.ToUniversalTime();
        if (elapsed.TotalMinutes < 1) return "Ahora";
        if (elapsed.TotalHours < 1) return $"Hace {(int)elapsed.TotalMinutes} min";
        if (elapsed.TotalDays < 1) return $"Hace {(int)elapsed.TotalHours} h";
        if (elapsed.TotalDays < 7) return $"Hace {(int)elapsed.TotalDays} d";
        return createdAt.ToLocalTime().ToString("dd/MM/yyyy");
    }
}
