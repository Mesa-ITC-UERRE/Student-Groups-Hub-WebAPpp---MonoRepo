    // ── Logo upload methods ────────────────────────────────────────────────────

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoError = null;

        var mime = e.File.ContentType;
        if (!StorageService.AllowedMimeTypes.Contains(mime))
        {
            _logoError = "Formato no permitido. Usa JPEG, PNG, WebP o GIF.";
            return;
        }

        _logoZoomSlider = 0;
        _showLogoCropper = true;
        _logoCropperJustOpened = true;
    }

    private async Task CancelLogoCrop()
    {
        _showLogoCropper = false;
        _logoError = null;
        _logoZoomSlider = 0;
        await JS.InvokeVoidAsync("avatarCrop.destroy", "groupLogoCanvas");
    }

    private async Task OnLogoZoomChanged(ChangeEventArgs e)
    {
        _logoZoomSlider = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        await JS.InvokeVoidAsync("avatarCrop.setZoom", "groupLogoCanvas", _logoZoomSlider);
    }

    private async Task SaveLogo()
    {
        if (_group is null)
        {
            return;
        }

        _savingLogo = true;
        _logoError = null;

        try
        {
            var b64 = await JS.InvokeAsync<string>("avatarCrop.export", "groupLogoCanvas");
            if (string.IsNullOrWhiteSpace(b64))
            {
                _logoError = "No se pudo procesar la imagen.";
                return;
            }

            var bytes = Convert.FromBase64String(b64);
            var updated = await GroupService.UploadLogoAsync(
                _group.Id,
                bytes,
                "image/jpeg",
                "jpg");

            if (updated is not null)
            {
                _group = updated;
                _logoPreviewUrl = $"data:image/jpeg;base64,{b64}";
                _showLogoCropper = false;
                _logoZoomSlider = 0;
                await JS.InvokeVoidAsync("avatarCrop.destroy", "groupLogoCanvas");
            }
            else
            {
                _logoError = "No se pudo guardar el logo.";
            }
        }
        catch (InvalidOperationException ex)
        {
            _logoError = ex.Message;
        }
        catch
        {
            _logoError = "Error inesperado al subir el logo.";
        }
        finally
        {
            _savingLogo = false;
        }
    }

    // ── Banner upload methods ──────────────────────────────────────────────────

    private async Task OnBannerSelected(InputFileChangeEventArgs e)
    {
        _bannerError = null;
        _bannerPreviewUrl = null;
        _bannerPendingBytes = null;

        var file = e.File;
        const long maxBytes = 5L * 1024 * 1024;

        if (!StorageService.AllowedMimeTypes.Contains(file.ContentType))
        {
            _bannerError = "Formato no permitido. Usa JPEG, PNG, WebP o GIF.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            _bannerPendingBytes = ms.ToArray();
        }
        catch (IOException)
        {
            _bannerError = "El archivo supera el límite de 5 MB.";
            return;
        }

        var rawExt = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();

        _bannerPendingExt = string.IsNullOrEmpty(rawExt)
            ? file.ContentType.Split('/').Last().Replace("jpeg", "jpg")
            : rawExt;

        _bannerPendingContentType = file.ContentType;

        var base64 = Convert.ToBase64String(_bannerPendingBytes);
        _bannerPreviewUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private void CancelBannerPreview()
    {
        _bannerPreviewUrl = null;
        _bannerPendingBytes = null;
        _bannerPendingContentType = null;
        _bannerPendingExt = null;
        _bannerError = null;
    }

    private async Task SaveBanner()
    {
        if (_group is null ||
            _bannerPendingBytes is null ||
            _bannerPendingContentType is null ||
            _bannerPendingExt is null)
        {
            return;
        }

        _savingBanner = true;
        _bannerError = null;

        try
        {
            var updated = await GroupService.UploadBannerAsync(
                _group.Id,
                _bannerPendingBytes,
                _bannerPendingContentType,
                _bannerPendingExt);

            if (updated is not null)
            {
                _group = updated;
                _bannerPreviewUrl = null;
                _bannerPendingBytes = null;
                _bannerPendingContentType = null;
                _bannerPendingExt = null;
            }
            else
            {
                _bannerError = "No se pudo guardar el banner.";
            }
        }
        catch (InvalidOperationException ex)
        {
            _bannerError = ex.Message;
        }
        catch
        {
            _bannerError = "Error inesperado al subir el banner.";
        }
        finally
        {
            _savingBanner = false;
        }
    }

    // ── Create Event state & methods ──────────────────────────────────────────

    private bool    _showCreateEvent;
    private string  _evTitle       = "";
    private string? _evDescription;
    private string? _evLocation;
    private DateTime _evStart      = DateTime.Now.AddDays(1);
    private DateTime _evEnd        = DateTime.Now.AddDays(1).AddHours(2);
    private int?    _evCapacity;
    private string  _evVisibility  = "public";
    private bool    _savingEvent;
    private string? _eventError;

    private void CloseCreateEvent()
    {
        _showCreateEvent = false;
        _evTitle         = "";
        _evDescription   = null;
        _evLocation      = null;
        _evStart         = DateTime.Now.AddDays(1);
        _evEnd           = DateTime.Now.AddDays(1).AddHours(2);
        _evCapacity      = null;
        _evVisibility    = "public";
        _eventError      = null;
    }

    private async Task SubmitCreateEvent()
    {
        if (string.IsNullOrWhiteSpace(_evTitle))
        {
            _eventError = "El título es requerido.";
            return;
        }
        if (_evEnd <= _evStart)
        {
            _eventError = "La fecha de fin debe ser posterior a la de inicio.";
            return;
        }
        if (_group is null) return;

        _savingEvent = true;
        _eventError  = null;
        try
        {
            var created = await EventService.CreateEventAsync(
                _group.Id,
                new BlazorCreateEventRequest(
                    _evTitle.Trim(),
                    string.IsNullOrWhiteSpace(_evDescription) ? null : _evDescription.Trim(),
                    string.IsNullOrWhiteSpace(_evLocation)    ? null : _evLocation.Trim(),
                    _evStart.ToUniversalTime(),
                    _evEnd.ToUniversalTime(),
                    _evCapacity,
                    "published",
                    _evVisibility));

            if (created is not null)
            {
                _events = (await EventService.GetForGroupAsync(_group.Id));
                CloseCreateEvent();
            }
            else
            {
                _eventError = "No se pudo crear el evento.";
            }
        }
        catch (InvalidOperationException ex) { _eventError = ex.Message; }
        catch { _eventError = "Error inesperado al crear el evento."; }
        finally { _savingEvent = false; }
    }

    // ── Posts state & methods ─────────────────────────────────────────────────

    private string  _newPostBody       = "";
    private byte[]? _postImageBytes;
    private string? _postImageContentType;
    private string? _postImageExt;
    private string? _postImagePreview;
    private bool    _submittingPost;
    private string? _postError;

    // Post author management (leaders only)
    private List<GroupPostAuthorModel> _postMembers   = [];
    private HashSet<Guid>              _postAuthorIds = [];

    private async Task OnPostImageSelected(InputFileChangeEventArgs e)
    {
        _postError        = null;
        _postImagePreview = null;
        _postImageBytes   = null;

        var file = e.File;
        if (!StorageService.AllowedMimeTypes.Contains(file.ContentType))
        {
            _postError = "Formato no permitido.";
            return;
        }
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5L * 1024 * 1024);
            using var ms     = new MemoryStream();
            await stream.CopyToAsync(ms);
            _postImageBytes = ms.ToArray();
        }
        catch (IOException) { _postError = "La imagen supera 5 MB."; return; }

        var rawExt = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
        _postImageExt         = string.IsNullOrEmpty(rawExt) ? "jpg" : rawExt;
        _postImageContentType = file.ContentType;
        _postImagePreview     = $"data:{file.ContentType};base64,{Convert.ToBase64String(_postImageBytes)}";
    }

    private void RemovePostImage()
    {
        _postImageBytes       = null;
        _postImageContentType = null;
        _postImageExt         = null;
        _postImagePreview     = null;
    }

    private async Task SubmitPost()
    {
        if (_group is null || string.IsNullOrWhiteSpace(_newPostBody)) return;
        _submittingPost = true;
        _postError      = null;
        try
        {
            var created = await PostService.CreatePostAsync(
                _group.Id, _newPostBody,
                _postImageBytes, _postImageContentType, _postImageExt);
            if (created is not null)
            {
                _posts.Insert(0, created);
                _newPostBody  = "";
                RemovePostImage();
            }
            else { _postError = "No se pudo publicar."; }
        }
        catch (InvalidOperationException ex) { _postError = ex.Message; }
        catch { _postError = "Error inesperado al publicar."; }
        finally { _submittingPost = false; }
    }

    private async Task DeletePost(Guid postId)
    {
        if (_group is null) return;
        var ok = await PostService.DeletePostAsync(_group.Id, postId);
        if (ok) _posts.RemoveAll(p => p.Id == postId);
    }

    private async Task TogglePostAuthor(Guid userId, bool allowed)
    {
        if (_group is null) return;
        await PostService.SetAuthorAsync(_group.Id, userId, allowed);
        if (allowed) _postAuthorIds.Add(userId);
        else         _postAuthorIds.Remove(userId);
    }
