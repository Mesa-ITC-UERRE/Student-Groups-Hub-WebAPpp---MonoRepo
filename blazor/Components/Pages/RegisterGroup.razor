@page "/groups/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject GroupRegistrationApiService RegistrationService
@inject GroupApiService GroupService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject UserErrorService UserErrors

<PageTitle>Solicitar Grupo — Grupos Estudiantiles Hub</PageTitle>

<AuthorizeView Context="authState">
    <Authorized>
        <section class="hero-gradient py-4 text-white">
            <div class="container max-w-xl">
                <a href="/groups" class="text-white-50 text-decoration-none small mb-3 d-inline-flex align-items-center gap-1">
                    ← Grupos
                </a>
                <h1 class="page-hero-title fw-bold mb-1">Solicitar Nuevo Grupo</h1>
                <p class="page-hero-subtitle mb-0">
                    Completa el formulario. El equipo de U-ERRE revisará tu solicitud y te notificará.
                </p>
            </div>
        </section>

        <section class="py-5" style="background:var(--uerre-surface);">
            <div class="container max-w-xl">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">

                @if (_success)
                {
                    <div class="card-uerre p-5 text-center">
                        <div class="mb-3 text-success"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 1.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17m4.03 5.97-5.28 5.29-2.28-2.28a.75.75 0 1 0-1.06 1.06l2.81 2.81a.75.75 0 0 0 1.06 0l5.81-5.82a.75.75 0 0 0-1.06-1.06"/></svg></div>
                        <h4 class="fw-bold mb-2">¡Solicitud enviada!</h4>
                        <p class="text-muted mb-4">
                            Tu solicitud ha sido recibida. Te notificaremos cuando sea revisada.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/perfil" class="btn btn-uerre-outline">Ver mis solicitudes</a>
                            <a href="/groups" class="btn btn-uerre-primary">Explorar grupos</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-uerre p-4 p-md-5">
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger rounded-3 small">@_error</div>
                        }

                        <EditForm Model="_form" OnValidSubmit="HandleSubmit" FormName="register-group">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Nombre del grupo <span class="text-danger">*</span>
                                </label>
                                <InputText @bind-Value="_form.ProposedGroupName"
                                           class="form-control rounded-3"
                                           placeholder="Ej. Club de Robótica U-ERRE"
                                           maxlength="200" />
                                <ValidationMessage For="() => _form.ProposedGroupName" class="small text-danger" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Descripción del grupo</label>
                                <InputTextArea @bind-Value="_form.ProposedDescription"
                                              class="form-control rounded-3"
                                              rows="4"
                                              placeholder="¿De qué trata el grupo? ¿Qué actividades realizarán?" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Correo de contacto <span class="text-danger">*</span>
                                </label>
                                <InputText @bind-Value="_form.ContactEmail"
                                           type="email"
                                           class="form-control rounded-3"
                                           placeholder="tu.nombre@uerre.mx" />
                                <ValidationMessage For="() => _form.ContactEmail" class="small text-danger" />
                                <div class="form-text">Te contactaremos a este correo con el resultado.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Categoría sugerida</label>
                                <select class="form-select rounded-3" @bind="_selectedCategory">
                                    <option value="">— Sin preferencia —</option>
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                    <option value="__nueva__">Otra (nueva)…</option>
                                </select>
                                @if (_selectedCategory == "__nueva__")
                                {
                                    <input type="text"
                                           class="form-control rounded-3 mt-2"
                                           placeholder="Escribe el nombre de la nueva categoría"
                                           @bind="_customCategory"
                                           maxlength="100" />
                                }
                                <div class="form-text">
                                    Opcional — el admin puede asignar la categoría definitiva al aprobar.
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-3 pt-2">
                                <a href="/groups" class="btn btn-uerre-outline">Cancelar</a>
                                <button type="submit" class="btn btn-uerre-primary px-4" disabled="@_submitting">
                                    @if (_submitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Enviando...</span>
                                    }
                                    else
                                    {
                                        <span>Enviar solicitud</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                }
                    </div>
                </div>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="hero-gradient text-white position-relative overflow-hidden"
                 style="padding-top:5rem;padding-bottom:6rem;">
            <div class="hero-blob-1"></div>
            <div class="hero-blob-2"></div>
            <div class="container-uerre position-relative" style="z-index:1;">
                <div class="row justify-content-center">
                    <div class="col-12 col-lg-8 text-center">
                        <div class="animate-fade-up mb-4">
                            <span class="rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2"
                                  style="border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);
                                         backdrop-filter:blur(8px);font-size:.7rem;font-weight:600;
                                         letter-spacing:.08em;text-transform:uppercase;">
                                Acceso restringido para estudiantes U-ERRE
                            </span>
                        </div>
                        <h1 class="animate-fade-up delay-1 fw-bold text-white lh-1 mb-3"
                            style="font-family:var(--uerre-font-heading);font-size:clamp(2.25rem,5vw,3.75rem);letter-spacing:-.02em;">
                            Solicita un grupo<br /><span style="color:#fbbf24;">iniciando sesión.</span>
                        </h1>
                        <p class="animate-fade-up delay-2 mb-4 lh-lg mx-auto"
                           style="color:rgba(255,255,255,.75);max-width:520px;font-size:1.0625rem;">
                            Esta sección está disponible únicamente para estudiantes de <span style="white-space:nowrap;">U-ERRE</span> con cuenta institucional.
                        </p>
                        <div class="animate-fade-up delay-3 d-flex justify-content-center gap-3 flex-wrap">
                            <LoginLink Class="btn btn-light btn-lg px-5 fw-bold"
                               Style="color:#5b21b6;border-radius:12px;font-family:var(--uerre-font-heading);font-size:.9375rem;">
                                Iniciar Sesión →
                            </LoginLink>
                            <a href="/"
                               class="btn btn-lg px-4 fw-semibold"
                               style="border:1.5px solid rgba(255,255,255,.25);background:rgba(255,255,255,.1);color:#fff;border-radius:12px;backdrop-filter:blur(8px);font-size:.875rem;">
                                Volver al inicio
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly RegisterGroupForm _form = new();
    private bool _submitting;
    private bool _success;
    private string? _error;

    private List<string> _categories = [];
    private string _selectedCategory = "";
    private string _customCategory = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        _categories = await GroupService.GetCategoriesAsync();
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        try
        {
            string? proposedCategory = _selectedCategory == "__nueva__"
                ? (string.IsNullOrWhiteSpace(_customCategory) ? null : _customCategory.Trim())
                : (string.IsNullOrWhiteSpace(_selectedCategory) ? null : _selectedCategory);

            var request = new CreateGroupRegistrationRequest(
                _form.ProposedGroupName.Trim(),
                string.IsNullOrWhiteSpace(_form.ProposedDescription) ? null : _form.ProposedDescription.Trim(),
                _form.ContactEmail.Trim(),
                proposedCategory);

            var result = await RegistrationService.CreateAsync(request);
            if (result is not null)
                _success = true;
            else
                _error = "Error al enviar la solicitud. Por favor intenta de nuevo.";
        }
        catch (Exception ex)
        {
            _error = UserErrors.Handle(ex, "No se pudo enviar la solicitud.");
        }
        finally
        {
            _submitting = false;
        }
    }

    private class RegisterGroupForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre del grupo es requerido.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string ProposedGroupName { get; set; } = "";

        public string? ProposedDescription { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo de contacto es requerido.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ingresa un correo válido.")]
        public string ContactEmail { get; set; } = "";
    }
}
