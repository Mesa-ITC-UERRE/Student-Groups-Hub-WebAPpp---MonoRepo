@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject UserApiService UserApiSvc
@inject UserStateService UserState

<nav class="navbar navbar-expand-md navbar-uerre sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <div class="navbar-logo-box">U</div>
            <div>
                <div class="navbar-brand-name">Grupos Estudiantiles</div>
                <div class="navbar-brand-sub">U-ERRE</div>
            </div>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse navbar-collapse-uerre" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-md-0 d-none d-md-flex">
                <li class="nav-item">
                    <NavLink class="nav-link nav-accent-slate" href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-blue" href="/groups">Grupos</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-violet" href="/mis-grupos">Mis Grupos</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-amber" href="/events">Eventos</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-teal" href="/calendario">Calendario</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-rose" href="/timeline">Linea del Tiempo</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-accent-emerald" href="/feur">FEUR</NavLink>
                        </li>
                        @if (_isAdmin)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link nav-accent-orange fw-semibold"
                                         href="/admin">
                                    Admin
                                </NavLink>
                            </li>
                        }
                    </Authorized>
                </AuthorizeView>
            </ul>

            <div class="mobile-menu-grid d-grid d-md-none" aria-label="Accesos principales">
                <NavLink class="mobile-menu-tile mobile-menu-slate" href="/" Match="NavLinkMatch.All">
                    <span class="mobile-menu-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.223 2.293a1 1 0 0 1 1.554 0l8.5 9A1 1 0 0 1 20.5 13H19v7a1.5 1.5 0 0 1-1.5 1.5H15a1 1 0 0 1-1-1v-4.5a1.5 1.5 0 0 0-1.5-1.5h-1a1.5 1.5 0 0 0-1.5 1.5V20.5a1 1 0 0 1-1 1H6.5A1.5 1.5 0 0 1 5 20V13H3.5a1 1 0 0 1-.723-1.707z"/></svg>
                    </span>
                    <span>Inicio</span>
                </NavLink>
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="mobile-menu-tile mobile-menu-blue" href="/groups">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8m-8 0a4 4 0 1 1 0-8 4 4 0 0 1 0 8m7 2c2.67 0 8 1.34 8 4v1H1v-1c0-2.66 5.33-4 8-4 .93 0 2.09.16 3.27.46A7.7 7.7 0 0 0 9 14c-2.42 0-5.5.89-6.49 2.5h12A7.74 7.74 0 0 0 15 14c1.18-.3 2.34-.46 3.27-.46z"/></svg>
                            </span>
                            <span>Grupos</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-violet" href="/mis-grupos">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 12c4.42 0 8 1.79 8 4v2H4v-2c0-2.21 3.58-4 8-4"/></svg>
                            </span>
                            <span>Mis Grupos</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-amber" href="/events">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3A3.25 3.25 0 0 1 21 6.25v11.5A3.25 3.25 0 0 1 17.75 21H6.25A3.25 3.25 0 0 1 3 17.75V6.25A3.25 3.25 0 0 1 6.25 3zM19.5 8.5h-15v9.25c0 .966.784 1.75 1.75 1.75h11.5a1.75 1.75 0 0 0 1.75-1.75z"/></svg>
                            </span>
                            <span>Eventos</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-teal" href="/calendario">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3A3.25 3.25 0 0 1 21 6.25v11.5A3.25 3.25 0 0 1 17.75 21H6.25A3.25 3.25 0 0 1 3 17.75V6.25A3.25 3.25 0 0 1 6.25 3zM19.5 8.5h-15v9.25c0 .966.784 1.75 1.75 1.75h11.5a1.75 1.75 0 0 0 1.75-1.75zm-11.75 2a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5"/></svg>
                            </span>
                            <span>Calendario</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-rose" href="/timeline">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4m0 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4m0 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4m5-13h10v2H10zm0 7h10v2H10zm0 7h10v2H10z"/></svg>
                            </span>
                            <span>Línea del Tiempo</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-emerald" href="/feur">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 3 6v2h18V6zm-7 8v7H3v2h18v-2h-2v-7h-2v7h-4v-7h-2v7H7v-7zm-2 11v2h18v-2z"/></svg>
                            </span>
                            <span>FEUR</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-gold" href="/notifications">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/></svg>
                            </span>
                            <span>Notificaciones</span>
                        </NavLink>
                        <NavLink class="mobile-menu-tile mobile-menu-purple" href="/perfil">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2m0 4.5a3 3 0 1 1 0 6 3 3 0 0 1 0-6m0 13a7.46 7.46 0 0 1-5.25-2.18A6.48 6.48 0 0 1 12 14.5a6.48 6.48 0 0 1 5.25 2.82A7.46 7.46 0 0 1 12 19.5"/></svg>
                            </span>
                            <span>Mi Panel</span>
                        </NavLink>
                        @if (_isAdmin)
                        {
                            <NavLink class="mobile-menu-tile mobile-menu-orange" href="/admin">
                                <span class="mobile-menu-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 8 3v6c0 5.25-3.44 9.74-8 11-4.56-1.26-8-5.75-8-11V5zm0 5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5m0 6.5c-2.21 0-4 1.12-4 2.5v1h8v-1c0-1.38-1.79-2.5-4-2.5"/></svg>
                                </span>
                                <span>Admin</span>
                            </NavLink>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="mobile-menu-tile mobile-menu-purple" href="MicrosoftIdentity/Account/SignIn">
                            <span class="mobile-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 17v-3H3v-4h7V7l5 5zm9-13H9a2 2 0 0 0-2 2v2h2V6h10v12H9v-2H7v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2"/></svg>
                            </span>
                            <span>Iniciar Sesión</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="d-none d-md-flex align-items-center gap-2 navbar-user-actions">
                <AuthorizeView>
                    <Authorized>
                        <!-- Notification bell -->
                        <NotificationBell />

                        <!-- User dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-sm d-flex align-items-center gap-2 navbar-user-btn dropdown-toggle"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (_avatarUrl is not null)
                                {
                                    <img src="@_avatarUrl" alt="avatar"
                                         class="rounded-circle navbar-avatar"
                                         style="width:32px;height:32px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="navbar-avatar">
                                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                }
                                <span class="d-none d-md-inline small fw-semibold text-truncate" style="max-width:120px;">
                                    @context.User.Identity?.Name
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" href="/perfil">Mi Panel</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="MicrosoftIdentity/Account/SignOut">
                                        Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-uerre-primary btn-sm px-4" href="MicrosoftIdentity/Account/SignIn">
                            Iniciar Sesión
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool _isAdmin;
    private string? _avatarUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user   = await UserApiSvc.GetMeAsync();
            _isAdmin   = user?.IsAdmin == true;
            _avatarUrl = user?.AvatarUrl;
            UserState.SetAvatar(_avatarUrl);
        }
        catch { _isAdmin = false; }

        UserState.OnChange += OnUserStateChanged;
    }

    private void OnUserStateChanged()
    {
        _avatarUrl = UserState.AvatarUrl;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => UserState.OnChange -= OnUserStateChanged;
}
