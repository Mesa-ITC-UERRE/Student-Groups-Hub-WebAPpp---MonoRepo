@inherits LayoutComponentBase

<div class="layout-wrapper">
    <NavMenu />

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4 py-5">
                <div class="d-flex align-items-center gap-2">
                    <div class="footer-logo-box">U</div>
                    <div>
                        <div class="fw-bold text-white small">Grupos Estudiantiles</div>
                        <div class="text-white" style="font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;">Universidad Regiomontana</div>
                    </div>
                </div>
                <div>
                    <h6 class="footer-section-title">Universidad</h6>
                    <ul class="list-unstyled footer-links mb-0">
                        <li><a href="https://www.u-erre.talisis.com/" target="_blank" rel="noopener">U-ERRE Website</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom border-top border-secondary py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-white small">&copy; @DateTime.Now.Year Grupos Estudiantiles — U-ERRE. Todos los derechos reservados.</span>
                <span class="text-white small">Hecho con &hearts; por estudiantes</span>
            </div>
        </div>
    </footer>
</div>

<MobileTabBar />

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&times;</span>
</div>
